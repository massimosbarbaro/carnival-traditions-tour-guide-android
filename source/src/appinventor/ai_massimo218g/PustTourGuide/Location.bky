<xml xmlns="http://www.w3.org/1999/xhtml"><block type="global_declaration" id="~AEU}UZh}znq1`CiIp=d" x="-239" y="-1221"><field name="NAME">LocationsNames</field><value name="VALUE"><block type="lists_create_with" id="Ti*RJKY-VPD{4V%XccaU"><mutation items="9"></mutation><value name="ADD0"><block type="text" id=";q)j$]-=1$Ohm~)nT0/X"><field name="TEXT">Tischlbong - Timau</field></block></value><value name="ADD1"><block type="text" id="/0y@Hq%C]d+u)Q_L9$u`"><field name="TEXT">Zahre - Sauris</field></block></value><value name="ADD2"><block type="text" id="=lMT(OV#z%gvT|cfqJwG"><field name="TEXT">Plodn - Sappada</field></block></value><value name="ADD3"><block type="text" id="zK=$q[ZYQ0cDi=8ARPF}"><field name="TEXT">Canale d’Agordo</field></block></value><value name="ADD4"><block type="text" id="?$9.]zgD?^kn|+fT#w82"><field name="TEXT">Podgrad - Castelnuovo d’Istria</field></block></value><value name="ADD5"><block type="text" id="[4/zf9PWc|b*CwAbLA:U"><field name="TEXT">Lig</field></block></value><value name="ADD6"><block type="text" id=":(8}sI[lna%p4bS)7ps9"><field name="TEXT">Breginj - Bergogna</field></block></value><value name="ADD7"><block type="text" id="Y[i1:y`{-x;/dM,AY=0n"><field name="TEXT">Cerkno</field></block></value><value name="ADD8"><block type="text" id="02Z2B-`-=l_^`s$hg4o6"><field name="TEXT">Drežnica</field></block></value></block></value></block><block type="global_declaration" id="]xW5~2@TtP@+]E0{Io%|" x="-775" y="-1021"><field name="NAME">LanguageIndex</field><value name="VALUE"><block type="lists_create_with" id="F/aWv*;Dr`]ER?T{~W.#"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="27uKx3smA/F@`=X?(Anj"><field name="TEXT">Si</field></block></value><value name="ADD1"><block type="text" id="2]7/aD26zOBnp!sWH-w4"><field name="TEXT">It</field></block></value><value name="ADD2"><block type="text" id="H966j%kt)tQYKb.2ixBm"><field name="TEXT">Gb</field></block></value><value name="ADD3"><block type="text" id="(DsqysU}xOvMx5_~MAfT"><field name="TEXT">De</field></block></value></block></value></block><block type="global_declaration" id="ZN|Ljgd!.L?ju/N)b+Fc" x="-756" y="-878"><field name="NAME">LocationIndex</field><value name="VALUE"><block type="math_number" id=",CVgf{,Qu@%nJW8dOo5_"><field name="NUM">0</field></block></value></block><block type="global_declaration" id="ysHu]:`zrh)c*2oJkUcL" x="-738" y="-846"><field name="NAME">Locations</field><value name="VALUE"><block type="lists_create_with" id="~mgihImG;*OZ7(dFP]--"><mutation items="9"></mutation><value name="ADD0"><block type="text" id="0|V);B)ovx86GUwM#~st"><field name="TEXT">Timau</field></block></value><value name="ADD1"><block type="text" id="w2^Vpd[[?p@604=9w(+q"><field name="TEXT">Sauris</field></block></value><value name="ADD2"><block type="text" id="t1*T6y|)-SX4}(HPpS?+"><field name="TEXT">Sappada</field></block></value><value name="ADD3"><block type="text" id=".)xT_k$|@{.}3q7UD18R"><field name="TEXT">Agordo</field></block></value><value name="ADD4"><block type="text" id="n5pHx56kOtrXU=td0`3j"><field name="TEXT">Podgrad</field></block></value><value name="ADD5"><block type="text" id="~sb@cKpX:Bj8E_)G93@#"><field name="TEXT">Lig</field></block></value><value name="ADD6"><block type="text" id="AGU5okSQjhyX-??n-5G8"><field name="TEXT">Bregin</field></block></value><value name="ADD7"><block type="text" id="*@I2yg{JKa_ccV0)?cE^"><field name="TEXT">Cerkno</field></block></value><value name="ADD8"><block type="text" id="ab96.B|_6H8@.UQ$xOk:"><field name="TEXT">Dreznica</field></block></value></block></value></block><block type="component_event" id="2!:4mpk6NK3w8ESESx}e" x="100" y="-841"><mutation component_type="Form" is_generic="false" instance_name="Location" event_name="Initialize"></mutation><field name="COMPONENT_SELECTOR">Location</field><statement name="DO"><block type="lexical_variable_set" id="__aCR/{A(X(2/M2G(X/h"><field name="VAR">global LocationIndex</field><value name="VALUE"><block type="lists_position_in" id="8UStZzh!7u[=H3`](J*Z"><value name="ITEM"><block type="component_method" id="UX}y==2($,Jx%?H?HahF"><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="OeJ0O5gZ*3DPtj8qp)1z"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="Xk]@bm@^B4/p*tT1KAH5"><field name="TEXT">Rodda</field></block></value></block></value><value name="LIST"><block type="lexical_variable_get" id="IxmH(d|w{ZJBb*o_TSz8"><field name="VAR">global Locations</field></block></value></block></value><next><block type="lexical_variable_set" id=",Tf7JfON[zK3vCqXukVy"><field name="VAR">global LanguageIndex</field><value name="VALUE"><block type="component_method" id="?LQsy*GMFvWE$,4ZKe5="><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="4L/W],[X8YB5@5bC^{9t"><field name="TEXT">Language</field></block></value><value name="ARG1"><block type="text" id="BpvlA+T{|V=UFEUvlM!%"><field name="TEXT">Si</field></block></value></block></value><next><block type="component_set_get" id="7=Ao;z$:q+ftLkXK|-}H"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="LocationLabel"></mutation><field name="COMPONENT_SELECTOR">LocationLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="lists_select_item" id="Y9NjeZ4K6u]nLTi7W!(x"><value name="LIST"><block type="lexical_variable_get" id="A:Z(~0N;BE9|cM]R^f|i"><field name="VAR">global LocationsNames</field></block></value><value name="NUM"><block type="lexical_variable_get" id="_FpdZ=npv@+vB7tgz#I;"><field name="VAR">global LocationIndex</field></block></value></block></value><next><block type="component_set_get" id="v$6b9Z;cWn-:D80ix/}u"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="controls_choose" id="GOpr^r?cwWr-8VPYaFbs"><value name="TEST"><block type="text_compare" id="oQZod?Dy624-I}|enWI4"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="]Ee4qs!So[f[aB-c^3|e"><field name="VAR">global LanguageIndex</field></block></value><value name="TEXT2"><block type="text" id="zUEn*v{%Yk9XgwBI{)9J"><field name="TEXT">Si</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id="2B+Zjp`7tj1{z+Q!YSfx"><value name="LIST"><block type="lexical_variable_get" id="V.){b$:5292Nv7DG5^vo"><field name="VAR">global DescriptionsSi</field></block></value><value name="NUM"><block type="lexical_variable_get" id="!Q3wTihe8L?n$f*m(P.4"><field name="VAR">global LocationIndex</field></block></value></block></value><value name="ELSERETURN"><block type="controls_choose" id="-3eq5(/wI)rn5PZe.G!t"><value name="TEST"><block type="text_compare" id="YgiHRi7fV,0L$/2vhdxt"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="Qm*S?xq3~;gUw364W*iL"><field name="VAR">global LanguageIndex</field></block></value><value name="TEXT2"><block type="text" id="1s@BEDB^S+gNf@tm^ksh"><field name="TEXT">It</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id=":5c^BR3#r,:O`jPuzi)0"><value name="LIST"><block type="lexical_variable_get" id="TD|dRTGWpI+B;v=.9}RH"><field name="VAR">global DescriptionsIt</field></block></value><value name="NUM"><block type="lexical_variable_get" id="~;2bvMD-;mP%b;{KXl]."><field name="VAR">global LocationIndex</field></block></value></block></value><value name="ELSERETURN"><block type="controls_choose" id="4NhCo`zKsImBZr%y_KP6"><value name="TEST"><block type="text_compare" id="mbvWypL8X|BNUKL](wki"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="xvM@8=MP{C@+$yQ!QE,D"><field name="VAR">global LanguageIndex</field></block></value><value name="TEXT2"><block type="text" id="y;4:-I|4;b[#mKUk_#|i"><field name="TEXT">Gb</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id=":@#$%[%1QiJ+/G`XovCc"><value name="LIST"><block type="lexical_variable_get" id="KC-}9HZMz9[auO;};nEK"><field name="VAR">global DescriptionsGb</field></block></value><value name="NUM"><block type="lexical_variable_get" id="ejsT}wQZh:I3FqB!N|^%"><field name="VAR">global LocationIndex</field></block></value></block></value><value name="ELSERETURN"><block type="lists_select_item" id="BjdHN!JA2IsJvCuGBGR."><value name="LIST"><block type="lexical_variable_get" id=")vl?Jt7PGdY?nc!%Le#f"><field name="VAR">global DescriptionsDe</field></block></value><value name="NUM"><block type="lexical_variable_get" id="t8]4a:^fLo6?}/M)r+st"><field name="VAR">global LocationIndex</field></block></value></block></value></block></value></block></value></block></value><next><block type="component_set_get" id="Vg;:Zi#k%mX5n|s@3EUQ"><mutation component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Image1"></mutation><field name="COMPONENT_SELECTOR">Image1</field><field name="PROP">Picture</field><value name="VALUE"><block type="lists_select_item" id="D1,;23tBOcpNQ)cl~8HO"><value name="LIST"><block type="lexical_variable_get" id="F;.GzQ,b].tTDfqcg3cK"><field name="VAR">global Pictures</field></block></value><value name="NUM"><block type="lexical_variable_get" id="ZymRbLsvzAyavel){dES"><field name="VAR">global LocationIndex</field></block></value></block></value></block></next></block></next></block></next></block></next></block></statement></block><block type="global_declaration" id="DQla2*^0@|a-WE6j|3^7" x="-763" y="-541"><field name="NAME">Pictures</field><value name="VALUE"><block type="lists_create_with" id="LrqiZN?mvr78Wvhb{/!r"><mutation items="9"></mutation><value name="ADD0"><block type="text" id="MzsfDPG]k=Fnf`y?tr8,"><field name="TEXT">timau.jpg</field></block></value><value name="ADD1"><block type="text" id="~x?I?X6Lj0r2{~TnE6rO"><field name="TEXT">sauris.jpg</field></block></value><value name="ADD2"><block type="text" id="Q|u%bgbKto]L]i~6E]F%"><field name="TEXT">sappada.jpg</field></block></value><value name="ADD3"><block type="text" id="HNMZx]H}#.rXheE1TCbZ"><field name="TEXT">Agordo.jpg</field></block></value><value name="ADD4"><block type="text" id="p=6QpO[20}|T0V2|v7}r"><field name="TEXT">podgrad.jpg</field></block></value><value name="ADD5"><block type="text" id="XM##2mM^?k**zfpPD.g="><field name="TEXT">lig.jpg</field></block></value><value name="ADD6"><block type="text" id="JE(tG-:4qEPK[45M{^wt"><field name="TEXT">breg.jpg</field></block></value><value name="ADD7"><block type="text" id="{Lk`DV`rEVN#lKO1ads!"><field name="TEXT">cerkno.jpg</field></block></value><value name="ADD8"><block type="text" id="$}{)fdaDy+4T,6p/z%YR"><field name="TEXT">dreznica.jpg</field></block></value></block></value></block><block type="global_declaration" id="Mx9(FJ;aIdk%b6TJ$$vC" x="-777" y="-285"><field name="NAME">DescriptionsSi</field><value name="VALUE"><block type="lists_create_with" id="$7Wbt,C(]}v0`uIh{4#="><mutation items="9"></mutation><value name="ADD0"><block type="text" id="iLpFK^ts6My/RJ2PPY9c"><field name="TEXT">Timauski pust  se odvija  v starem nemškem govoru, ki se je tu ohranil skozi stoletja. Maske se tudi tu delijo na lepe in grde:  maske jutalan so oblečene so v belo srajco in krilo, klobuk s tančico jim povsem pokriva obraz. Dar maschkar, ki nosijo zvonce, so strašne in divje figure. </field></block></value><value name="ADD1"><block type="text" id="||1lQ^RE88x7`vsM$T[o"><field name="TEXT">V Saurisu/Zahre, nemškem jezikovnem otoku, naznanja pust rolar. Lepe in grde maškare (scheana schembln in scheintena schembln) gredo po vasi. Vodi jih kheirar, ki z veliko metlo pometa po tleh, da bi pregnal zimo in negativne sile. </field></block></value><value name="ADD2"><block type="text" id="f=AdS0kwS$MC{C*7Nurh"><field name="TEXT">Pust,  vosenòcht, se odvija tri nedelje, značilni pustni liki (letter) nosijo lesene maske (lovrn). Ob koncu pustnega časa prevladajo rollate, ki nosijo leseno oblične, obleko iz kož in dva velika zvonca, pred njimi pa hodijo pisani pajaci (pajazn).</field></block></value><value name="ADD3"><block type="text" id="m8y:I#*+`MyQf!.Qk*^R"><field name="TEXT">Zinghenesta je za Canale d’Agordo značilna maska in najvažnejši ženski pustni lik na območju Belluna. To je najlepše dekle v vasi, izvoljena kraljica vaškega praznika. Oblečena je praznično, z belim korzetom, nagubanim krilom, pisanimi robci in trakovi, rožami in bogatim nakitom. Na nogah nosi značilne scarpét in kraguljčke, v rokah ima šop rož. </field></block></value><value name="ADD4"><block type="text" id="v8=Ld0ou36,D/q^~WP!5"><field name="TEXT">Glavni lik v pustni skupini  je kliščar, ki s kleščami lovi svoje žrtve in jih premaže s sajami po obrazu. Drug pomemben lik je zgončar, oblečen v ovčjo kožo, s piramidastim klobukom, okrašenim s papirnatimi rožami, in z ob telesu obešenimi zvonci. </field></block></value><value name="ADD5"><block type="text" id="LNhYl;az{(h+/=N;q9L`"><field name="TEXT">Bakrene maske iz 19. stoletja so bajarji (pušpanov, pšenični, petelinji), ramauša, ramašton, braja; aluminijaste so nastale po drugi svetovni vojni in so lepe (mladoporočenca, zdravnik, žandar) ali grde (pustje, pustice z dojenčkom, z metlo, z vrečo, Rezijan, žena, ki nosi moža v košu, hudič, opica, daj-dam. </field></block></value><value name="ADD6"><block type="text" id="SejzirV8pAL+]eW[OyNq"><field name="TEXT">Ta debew pust je Breginjska značilna maska, ki jo mladi neoženjeni fantje (gejži) vozijo na vozičku in oznanjajo začetek pustovanja. Za njim je hodila pustica in nosila cekar, za obema sta šla še dva pusta in po hišah pobirala jajca.</field></block></value><value name="ADD7"><block type="text" id="qye4R]A:~kH2^k,q*rgP"><field name="TEXT">Starodavna laufarija je vila v Cerknem obnovljena leta 1956. Skupino sestavlja 25 laufarjev z lesenimi maskami in posebnimi oblekami, vse pa poteka po vnaprej določenem obredju, ki se po procesu konča z usmrtitvijo pusta.</field></block></value><value name="ADD8"><block type="text" id="GeFVs/=PlFST_7AqKi!M"><field name="TEXT">Drežniški pust spada med bolj znana pustovanja v Sloveniji. Šemijo se neporočeni fantje, ki sami izdelujejo lesene maske. Sprevod ta lepih, ta grdih in drugih mask se odvija na pustno soboto in prinaša srečo in veselje po domačijah.</field></block></value></block></value></block><block type="global_declaration" id="[!2|h(`K,Oe)#5qo}5XQ" x="-786" y="-10"><field name="NAME">DescriptionsIt</field><value name="VALUE"><block type="lists_create_with" id="QsRmo@Fc)@oO-JI]k:mC"><mutation items="9"></mutation><value name="ADD0"><block type="text" id="$,IG0_o{tK{M/(`QHl.N"><field name="TEXT">A Timau/Tischlbong il carnevale si svolge nell'antica parlata tedesca, le maschere si dividono in belle, gli jutalan vestiti di bianco e con il cappello con il velo che copre il volto, e brutte, dar maschkar (i campanacci),  figure paurose e selvagge. </field></block></value><value name="ADD1"><block type="text" id="F`1=60I^)`Vsgp1q@;$Q"><field name="TEXT">A Sauris/Zahre, isola linguistica tedesca, il rölar annuncia il carnevale. Le maschere belle (scheana schembln) e brutte (scheintena schembln) fanno il giro del paese, guidate dal kheirar, che con una grande scopa da stalla spazza il pavimento,  scacciando l’inverno e le forze negative. </field></block></value><value name="ADD2"><block type="text" id="NB%!srO302uK|5zNIY6Y"><field name="TEXT">Il carnevale, vosenòcht, si svolge per ben tre domeniche, protagonisti sono i personaggi mascherati (letter) con il viso coperto da maschere di legno (lovrn). Figura tipica è il rollate, con maschera di legno, vestito di pelli e due grossi campanacci, preceduto dai pajazn, machere colorate.</field></block></value><value name="ADD3"><block type="text" id="GwA8^(F[R^Th75F_5L^N"><field name="TEXT">La Zinghenésta è la ragazza più bella del paese, eletta annualmente regina del carnevale e della festa. É il personaggio tipico del carnevale di Canale d’Agordo e unica personalità femminile guida nei carnevali del bellunese. È vestita sfarzosamente, con un bianco corsetto, una gonna pieghettata da festa, fazzoletti colorati, nastri, collane, ciondoli, oggetti preziosi e fiori di carta ed in testa porta il “Cappello dei Coscritti”.</field></block></value><value name="ADD4"><block type="text" id="~|r{DNnJul7_}Rq=9#n!"><field name="TEXT">Il personaggio principale del gruppo è il kliščar che con delle tenaglie in legno rincorre gli spettatori per prenderli e poi annerirli con la fuliggine. Altra figura importante è lo zgončar che, vestito di pelle di pecora, porta molti campanacci e un bel cappello fiorito.</field></block></value><value name="ADD5"><block type="text" id="7/l=|DQtADWNoV=%,=Qs"><field name="TEXT">Le maschere di rame, del 19. secolo, sono i bajarji (di bosso, di frumento, di piume), ramauša, ramašton, braja; quelle in alluminio del secondo dopoguerra sono belle (gli sposi, il medico, il gendarme) o brutte (il pust, le pustice con il neonato, la scopa, la borsa, l'arrotino, la donna che porta l'uomo nella gerla, il diavolo, la scimmia e do-dai).</field></block></value><value name="ADD6"><block type="text" id="p80eO5G.vqh;!gi~4{sb"><field name="TEXT">La maschera tradizionale si chiama ta debew - quello grosso. Il giovedì grasso viene trasportato su una barella da giovani non sposati chiamati gejži.  Dietro di lui c’erano la pustica seguita da altre due figure che raccoglievano le uova.</field></block></value><value name="ADD7"><block type="text" id="eL/}ZV_)}:0iEDUC,X%O"><field name="TEXT">L'antica laufarija di Cerkno è stata ripresa nel 1956. Il gruppo è composto da 25 figure con maschere di legno e costumi particolari, spesso di materiali naturali. Il rituale prevede anche il processo al carnevale e l'esecuzione della condanna a morte.</field></block></value><value name="ADD8"><block type="text" id="8WCdw0FK2uxcZ]XJrC}6"><field name="TEXT">Il pust di Drežnica è tra i più noti in Slovenia. Sono i giovani celibi che vi partecipano a intagliare le maschere di legno. Il corteo comprende i belli, i brutti a altre maschere che il sabato di carnevale portano allegria nel paese.</field></block></value></block></value></block><block type="component_event" id="pL{7A#SDs)q;ph;;Fo7)" x="188" y="6"><mutation component_type="Button" is_generic="false" instance_name="BGallery" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BGallery</field><statement name="DO"><block type="component_set_get" id="+5MEcA@FFxwd%eM!M#B2"><mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="ActivityStarter2"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter2</field><field name="PROP">DataUri</field><value name="VALUE"><block type="text_join" id=",C)FlyHprecThj,POdM="><mutation items="2"></mutation><value name="ADD0"><block type="controls_choose" id="(Sz;%!E1H4##;[pfGnLr"><value name="TEST"><block type="math_compare" id="y/wR^;d1t/g[FRTMWp1:"><field name="OP">EQ</field><value name="A"><block type="lexical_variable_get" id="AQy+GB}BT(od%^zN^kkV"><field name="VAR">global LocationIndex</field></block></value><value name="B"><block type="math_number" id="bZt[[T?[=]1B1@ke=|5]"><field name="NUM">4</field></block></value></block></value><value name="THENRETURN"><block type="text" id="-2HpLR,o/KBAL/5?u}0b"><field name="TEXT">https://example.org/pust-agordo/#</field></block></value><value name="ELSERETURN"><block type="controls_choose" id="AKPBd30a:]kC6NOZjc4H"><value name="TEST"><block type="math_compare" id="I=#01z5dBpiqJ8(5ofi8"><field name="OP">LT</field><value name="A"><block type="lexical_variable_get" id="-q(RtA6Lq*%DjJuj)VDv"><field name="VAR">global LocationIndex</field></block></value><value name="B"><block type="math_number" id="N|52Ph^J.ZjJ}}j1q4r?"><field name="NUM">4</field></block></value></block></value><value name="THENRETURN"><block type="text" id="SgMs=h-Wg!o2XB}E|B,)"><field name="TEXT">https://example.org/pust-karnija/#</field></block></value><value name="ELSERETURN"><block type="text" id="Gn`3*W0ewo%aI868+$L}"><field name="TEXT">https://example.org/pust-slovenija/#</field></block></value></block></value></block></value><value name="ADD1"><block type="lists_select_item" id="sqC4bD}LKHSt`#L[drNp"><value name="LIST"><block type="lexical_variable_get" id="idz|+qeMBK[*%;-ey|I+"><field name="VAR">global Locations</field></block></value><value name="NUM"><block type="lexical_variable_get" id="/qm*!.C!.s$B,,S52_N,"><field name="VAR">global LocationIndex</field></block></value></block></value></block></value><next><block type="component_method" id="HVJQfzXp`;Q#P+Jdpb*b"><mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="ActivityStarter2"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter2</field></block></next></block></statement></block><block type="global_declaration" id="rC}-GAHk~k0_`{.KV{ec" x="-795" y="258"><field name="NAME">DescriptionsGb</field><value name="VALUE"><block type="lists_create_with" id="J_p~XS#wFo@M[_j*H;S~"><mutation items="9"></mutation><value name="ADD0"><block type="text" id="c-r=:tR:@OM]RVQg$fzW"><field name="TEXT">In Timau / Tischlbong the carnival takes place in the ancient German language, the masks are divided into beautiful, the jutalan dressed in white and with the hat with the veil covering the face, and ugly, dar maschkar (the cowbells), scary figures and wild.</field></block></value><value name="ADD1"><block type="text" id="*i7D|cXl0`$Gl.!B}.me"><field name="TEXT">In Sauris / Zahre, a German linguistic island, the rölar announces the carnival. The beautiful (scheana schembln) and ugly (scheintena schembln) masks go around the town, led by the kheirar, who sweeps the floor with a large barn broom, chasing away winter and negative forces.</field></block></value><value name="ADD2"><block type="text" id="6:;mcG6!{cz^Up!9z-!$"><field name="TEXT">The carnival, vosenòcht, takes place for three Sundays, the protagonists are the masked characters (letter) with their faces covered by wooden masks (lovrn). A typical figure is the rollate, with a wooden mask, dressed in skins and two large cowbells, preceded by pajazn, colored machere.</field></block></value><value name="ADD3"><block type="text" id="6%kXr}qxNC+Eoyd#Gi}6"><field name="TEXT">La Zinghenésta is the most beautiful girl in the country, annually elected queen of carnival and party. She is the typical character of the Canale d 'Agordo carnival and the only female personality who guides the carnivals in the Belluno area. She is lavishly dressed in a white corset, a pleated party skirt, colored handkerchiefs, ribbons, necklaces, pendants, precious objects and paper flowers and on her head she wears the "Hat of the Conscripts".</field></block></value><value name="ADD4"><block type="text" id="$m,.|Q/q}M77MKmnQ_#Q"><field name="TEXT">The main character of the group is the kliščar who chases the spectators with wooden tongs to catch them and then blacken them with soot. Another important figure is the zgončar who, dressed in sheepskin, wears many cowbells and a beautiful flowered hat.</field></block></value><value name="ADD5"><block type="text" id="uXb{ah|]O!L4(,}jf6eY"><field name="TEXT">The 19th century copper masks are the bajarji (boxwood, wheat, feather), ramauša, ramašton, braja; those in post-World War II aluminum are beautiful (the spouses, the doctor, the gendarme) or ugly (the pust, the pustice with the newborn, the broom, the bag, the grinder, the woman carrying the man in the pannier, the devil, the monkey and do-dai).</field></block></value><value name="ADD6"><block type="text" id=",5MC_MI-Ugh1M/_INvF["><field name="TEXT">The traditional mask is called ta debew - the big one. Fat Thursday is carried on a stretcher by unmarried young people called gejži. Behind him there were the pustica followed by two other figures who collected the eggs.</field></block></value><value name="ADD7"><block type="text" id="q+50T$,Yfl!X%r398^6_"><field name="TEXT">The ancient laufarija of Cerkno was revived in 1956. The group consists of 25 figures with wooden masks and particular costumes, often made of natural materials. The ritual also includes the trial at the carnival and the execution of the death sentence.</field></block></value><value name="ADD8"><block type="text" id="`)*d~j@Pta.;u^}]kKw("><field name="TEXT">The Drežnica carnival is one of the best known in Slovenia. It is the young celibates who participate in carving the wooden masks. The procession includes the beautiful, the ugly and other masks that bring joy to the village on Carnival Saturday.</field></block></value></block></value></block><block type="component_event" id="NW`GY~N~m}k-[DDKpg59" x="181" y="451"><mutation component_type="Button" is_generic="false" instance_name="BListen" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BListen</field><statement name="DO"><block type="component_method" id="gyhUJ@tKR.Nd/@R5OIsw"><mutation component_type="TextToSpeech" method_name="Speak" is_generic="false" instance_name="TextToSpeech1"></mutation><field name="COMPONENT_SELECTOR">TextToSpeech1</field><value name="ARG0"><block type="component_set_get" id="_F2nqv.#ZQ{J.#z1B97t"><mutation component_type="Label" set_or_get="get" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field></block></value></block></statement></block><block type="global_declaration" id="?-x:8.+-t9X8g_~t^JLs" x="-802" y="516"><field name="NAME">DescriptionsDe</field><value name="VALUE"><block type="lists_create_with" id="=b-^LKNdK2!E9eS-8]c]"><mutation items="9"></mutation><value name="ADD0"><block type="text" id="ch}FtA0hfiv5#;ByXgCO"><field name="TEXT">In Timau / Tischlbong findet der Karneval in der alten deutschen Sprache statt, die Masken sind unterteilt in schöne, der weiß gekleidete Jutalan und mit dem Hut mit dem Schleier über dem Gesicht und hässliche Dar-Maschar (die Kuhglocken), gruselige Figuren und wild.</field></block></value><value name="ADD1"><block type="text" id="S*n%D[=#@4,buXrbYpza"><field name="TEXT">In Sauris / Zahre, einer deutschen Sprachinsel, kündigt der Rölar den Karneval an. Die schönen (scheana schembln) und hässlichen (scheintena schembln) Masken ziehen durch die Stadt, angeführt vom Kheirar, der mit einem großen Scheunenbesen den Boden fegt und den Winter und die negativen Kräfte vertreibt.</field></block></value><value name="ADD2"><block type="text" id="FMdI?629Edhjpgv@+t25"><field name="TEXT">Der Karneval, vosenòcht, findet an drei Sonntagen statt, die Protagonisten sind die maskierten Figuren (Buchstaben), deren Gesichter mit Holzmasken (lovrn) bedeckt sind. Eine typische Figur ist das Rollat ​​mit einer Holzmaske, die in Felle gekleidet ist, und zwei großen Kuhglocken, denen pajaznische, farbige Machere vorausgehen.</field></block></value><value name="ADD3"><block type="text" id="H^ueGnWDQ|h(?B4}DRVS"><field name="TEXT">La Zinghenésta ist das schönste Mädchen des Landes und wird jährlich zur Königin des Karnevals und der Party gewählt. Sie ist die typische Figur des Karnevals am Canale d'Agordo und die einzige weibliche Persönlichkeit, die den Karneval in der Region Belluno leitet. Sie trägt ein weißes Korsett, einen plissierten Partyrock, bunte Taschentücher, Bänder, Halsketten, Anhänger, kostbare Gegenstände und Papierblumen und trägt auf ihrem Kopf den "Hut der Wehrpflichtigen".</field></block></value><value name="ADD4"><block type="text" id="iQzzfiX4/ez5y;q+;y|S"><field name="TEXT">Die Hauptfigur der Gruppe ist der Kliščar, der die Zuschauer mit einer Holzzange jagt, um sie zu fangen und sie dann mit Ruß zu schwärzen. Eine weitere wichtige Figur ist der Zgončar, der in Schaffell gekleidet viele Kuhglocken und einen schönen Blumenhut trägt.</field></block></value><value name="ADD5"><block type="text" id="S9DxgckCIcDWaZ/:V|E0"><field name="TEXT">Die Kupfermasken des 19. Jahrhunderts sind Bajarji (Buchsbaum, Weizen, Feder), Ramauša, Ramašton, Braja; Diejenigen aus Aluminium nach dem Zweiten Weltkrieg sind schön (Braut und Bräutigam, der Arzt, der Gendarm) oder hässlich (die Pust, die Pust mit dem Neugeborenen, der Besen, die Tasche, die Mühle, die Frau, die den Mann in der Packtasche, der Teufel, der Affe und do-dai).</field></block></value><value name="ADD6"><block type="text" id="h;~@FdEQ14e~5|6p)1LR"><field name="TEXT">Die traditionelle Maske heißt ta debew - die große. Der fette Donnerstag wird von unverheirateten jungen Leuten namens gejži auf einer Trage getragen. Hinter ihm befand sich die Pustica, gefolgt von zwei weiteren Personen, die die Eier sammelten.</field></block></value><value name="ADD7"><block type="text" id="V9SsG%Qu?N,liCgUu1~9"><field name="TEXT">Die alte Laufarija von Cerkno wurde 1956 wiederbelebt. Die Gruppe besteht aus 25 Figuren mit Holzmasken und besonderen Kostümen, oft aus natürlichen Materialien. Das Ritual beinhaltet auch den Prozess beim Karneval und die Vollstreckung des Todesurteils.</field></block></value><value name="ADD8"><block type="text" id="h{%kvGqNvL5%3zGbM?+("><field name="TEXT">Die Drežnica-Pust gehört zu den bekanntesten in Slowenien. Es sind die jungen Zölibate, die am Schnitzen der Holzmasken beteiligt sind. Die Prozession beinhaltet die schönen, hässlichen und anderen Masken, die der Stadt am Karnevalssamstag Freude bereiten.</field></block></value></block></value></block><block type="global_declaration" id="Vq*!;[StF5Vqn6]gC)]:" x="188" y="559"><field name="NAME">CurrentLocation</field><value name="VALUE"><block type="lists_create_with" id="tcIb$^}5Ph(|imAS2G!g"><mutation items="0"></mutation></block></value></block><block type="global_declaration" id="`S7wY!rGLIa)tl2O+Wm!" x="194" y="604"><field name="NAME">DestinationAddress</field><value name="VALUE"><block type="text" id="OTYJs13Afo_QdM-Wuk;?"><field name="TEXT">46.05333522774499, 14.472003351834035</field></block></value></block><block type="component_event" id="nh_%~zV/UYyCy@$0sF60" x="191" y="658"><mutation component_type="Button" is_generic="false" instance_name="BNavigate" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BNavigate</field><statement name="DO"><block type="lexical_variable_set" id="w4Reu$x*[6,[-*ckD#61"><field name="VAR">global LocationIndex</field><value name="VALUE"><block type="lists_position_in" id="]IK71!Xj`;]0bN=6@DMn"><value name="ITEM"><block type="component_method" id="XLeCRhQa$h$AP{[=qNLP"><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="jJ0Bph4%Q2ktb8|/}j|Y"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="o$Q]Fsp7=,RC.[g!3`tr"><field name="TEXT">Rodda</field></block></value></block></value><value name="LIST"><block type="lexical_variable_get" id="-!iwF|X%OL@x/pdmorw@"><field name="VAR">global Locations</field></block></value></block></value><next><block type="component_set_get" id="d3K*:EC3o/n$qhcZNG@e"><mutation component_type="ActivityStarter" set_or_get="set" property_name="Action" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field><field name="PROP">Action</field><value name="VALUE"><block type="text" id="NhRLols)m[DBTndI0D,/"><field name="TEXT">android.intent.action.VIEW</field></block></value><next><block type="component_set_get" id="3oYNX:lB]Ox3]h=BHJ)Q"><mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field><field name="PROP">DataUri</field><value name="VALUE"><block type="text_join" id="e4I;L6)qUBL[tiD%Vq##"><mutation items="2"></mutation><value name="ADD0"><block type="text" id="p|;zFhPA*M?JU1S9I,6P"><field name="TEXT">http://maps.google.com/maps/?daddr=</field></block></value><value name="ADD1"><block type="lists_select_item" id="q~77!whY+;6{l-!c=f82"><value name="LIST"><block type="lexical_variable_get" id=".l/^s)kJ@[H+PG:U]}4x"><field name="VAR">global Destinations</field></block></value><value name="NUM"><block type="lexical_variable_get" id=":HPJXk0.amj4sLz{/BP("><field name="VAR">global LocationIndex</field></block></value></block></value></block></value><next><block type="component_method" id="F*Psli0FMoJ@WvoX7O19"><mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field></block></next></block></next></block></next></block></statement></block><block type="component_event" id="GEgF%{!4^c]]@z#5_zN#" x="-401" y="811"><mutation component_type="Button" is_generic="false" instance_name="BBack" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BBack</field><statement name="DO"><block type="controls_closeScreen" id="VP?m+RZae!YMhPC?dZQ_"></block></statement></block><block type="global_declaration" id="A~4jpRJ@y/FyoQ;Q=heY" x="198" y="952"><field name="NAME">Destinations</field><value name="VALUE"><block type="lists_create_with" id="BLKNpEVc8?$K*d`tr+uT"><mutation items="9"></mutation><value name="ADD0"><block type="text" id="NwPB4!D71cWm^!$O~iz6"><field name="TEXT">46.5828968, 13.0039288</field></block></value><value name="ADD1"><block type="text" id="c2vNR]fOYgHzL-CW4ke$"><field name="TEXT">46.4653657, 12.7087174</field></block></value><value name="ADD2"><block type="text" id="y]1Lmc+*O0HsQqa@w