<xml xmlns="http://www.w3.org/1999/xhtml"><block type="global_declaration" id="gCr=Zvr(E*^zvx=F@A[j" x="-209" y="-1152"><field name="NAME">LocationsNames</field><value name="VALUE"><block type="lists_create_with" id="qTOt5`es^P~+*8kPRt|N"><mutation items="8"></mutation><value name="ADD0"><block type="text" id="=U0IRpqE!3(%SN25~g(b"><field name="TEXT">Bardo - Lusevera</field></block></value><value name="ADD1"><block type="text" id="hJm~]/vdn[}aASBJJ:Sj"><field name="TEXT">Prosnid - Prossenicco</field></block></value><value name="ADD2"><block type="text" id="HN8tl!:T@+DplSv6Gfoo"><field name="TEXT">Černjeja - Cergneu</field></block></value><value name="ADD3"><block type="text" id="qi(gV%J**HKb)H:vdnMw"><field name="TEXT">Čenta - Tarcento</field></block></value><value name="ADD4"><block type="text" id="|1}P]5DAwiB(mflx47v8"><field name="TEXT">Čenijebola - Canebola</field></block></value><value name="ADD5"><block type="text" id="tSBfP.WY{GBmD8TI__wI"><field name="TEXT">Mažarole - Masarolis</field></block></value><value name="ADD6"><block type="text" id="/|33!pj:rqtb=#iKSg=B"><field name="TEXT">Rezija - Resia</field></block></value><value name="ADD7"><block type="text" id="rdlKI6r)xw9-c)gcJB7y"><field name="TEXT">Bila - San Giorgio</field></block></value></block></value></block><block type="global_declaration" id="]xW5~2@TtP@+]E0{Io%|" x="-775" y="-1021"><field name="NAME">LanguageBardoIndex</field><value name="VALUE"><block type="lists_create_with" id="F/aWv*;Dr`]ER?T{~W.#"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="27uKx3smA/F@`=X?(Anj"><field name="TEXT">Si</field></block></value><value name="ADD1"><block type="text" id="2]7/aD26zOBnp!sWH-w4"><field name="TEXT">It</field></block></value><value name="ADD2"><block type="text" id="H966j%kt)tQYKb.2ixBm"><field name="TEXT">Gb</field></block></value><value name="ADD3"><block type="text" id="(DsqysU}xOvMx5_~MAfT"><field name="TEXT">De</field></block></value></block></value></block><block type="global_declaration" id="ZN|Ljgd!.L?ju/N)b+Fc" x="-786" y="-815"><field name="NAME">LocationBardoIndex</field><value name="VALUE"><block type="math_number" id=",CVgf{,Qu@%nJW8dOo5_"><field name="NUM">0</field></block></value></block><block type="component_event" id="2!:4mpk6NK3w8ESESx}e" x="30" y="-850"><mutation component_type="Form" is_generic="false" instance_name="LocationBardo" event_name="Initialize"></mutation><field name="COMPONENT_SELECTOR">LocationBardo</field><statement name="DO"><block type="lexical_variable_set" id="__aCR/{A(X(2/M2G(X/h"><field name="VAR">global LocationBardoIndex</field><value name="VALUE"><block type="lists_position_in" id="8UStZzh!7u[=H3`](J*Z"><value name="ITEM"><block type="component_method" id="UX}y==2($,Jx%?H?HahF"><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="OeJ0O5gZ*3DPtj8qp)1z"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="Xk]@bm@^B4/p*tT1KAH5"><field name="TEXT">Rodda</field></block></value></block></value><value name="LIST"><block type="lexical_variable_get" id="IxmH(d|w{ZJBb*o_TSz8"><field name="VAR">global Locations</field></block></value></block></value><next><block type="lexical_variable_set" id=",Tf7JfON[zK3vCqXukVy"><field name="VAR">global LanguageBardoIndex</field><value name="VALUE"><block type="component_method" id="?LQsy*GMFvWE$,4ZKe5="><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="4L/W],[X8YB5@5bC^{9t"><field name="TEXT">Language</field></block></value><value name="ARG1"><block type="text" id="BpvlA+T{|V=UFEUvlM!%"><field name="TEXT">Si</field></block></value></block></value><next><block type="component_set_get" id="7=Ao;z$:q+ftLkXK|-}H"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="LocationLabel"></mutation><field name="COMPONENT_SELECTOR">LocationLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="lists_select_item" id="Y9NjeZ4K6u]nLTi7W!(x"><value name="LIST"><block type="lexical_variable_get" id="A:Z(~0N;BE9|cM]R^f|i"><field name="VAR">global LocationsNames</field></block></value><value name="NUM"><block type="lexical_variable_get" id="_FpdZ=npv@+vB7tgz#I;"><field name="VAR">global LocationBardoIndex</field></block></value></block></value><next><block type="component_set_get" id="v$6b9Z;cWn-:D80ix/}u"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="controls_choose" id="GOpr^r?cwWr-8VPYaFbs"><value name="TEST"><block type="text_compare" id="oQZod?Dy624-I}|enWI4"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="]Ee4qs!So[f[aB-c^3|e"><field name="VAR">global LanguageBardoIndex</field></block></value><value name="TEXT2"><block type="text" id="zUEn*v{%Yk9XgwBI{)9J"><field name="TEXT">Si</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id="2B+Zjp`7tj1{z+Q!YSfx"><value name="LIST"><block type="lexical_variable_get" id="V.){b$:5292Nv7DG5^vo"><field name="VAR">global DescriptionsSi</field></block></value><value name="NUM"><block type="lexical_variable_get" id="!Q3wTihe8L?n$f*m(P.4"><field name="VAR">global LocationBardoIndex</field></block></value></block></value><value name="ELSERETURN"><block type="controls_choose" id="-3eq5(/wI)rn5PZe.G!t"><value name="TEST"><block type="text_compare" id="YgiHRi7fV,0L$/2vhdxt"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="Qm*S?xq3~;gUw364W*iL"><field name="VAR">global LanguageBardoIndex</field></block></value><value name="TEXT2"><block type="text" id="1s@BEDB^S+gNf@tm^ksh"><field name="TEXT">It</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id=":5c^BR3#r,:O`jPuzi)0"><value name="LIST"><block type="lexical_variable_get" id="TD|dRTGWpI+B;v=.9}RH"><field name="VAR">global DescriptionsIt</field></block></value><value name="NUM"><block type="lexical_variable_get" id="~;2bvMD-;mP%b;{KXl]."><field name="VAR">global LocationBardoIndex</field></block></value></block></value><value name="ELSERETURN"><block type="controls_choose" id="4NhCo`zKsImBZr%y_KP6"><value name="TEST"><block type="text_compare" id="mbvWypL8X|BNUKL](wki"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="xvM@8=MP{C@+$yQ!QE,D"><field name="VAR">global LanguageBardoIndex</field></block></value><value name="TEXT2"><block type="text" id="y;4:-I|4;b[#mKUk_#|i"><field name="TEXT">Gb</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id=":@#$%[%1QiJ+/G`XovCc"><value name="LIST"><block type="lexical_variable_get" id="KC-}9HZMz9[auO;};nEK"><field name="VAR">global DescriptionsGb</field></block></value><value name="NUM"><block type="lexical_variable_get" id="ejsT}wQZh:I3FqB!N|^%"><field name="VAR">global LocationBardoIndex</field></block></value></block></value><value name="ELSERETURN"><block type="lists_select_item" id="BjdHN!JA2IsJvCuGBGR."><value name="LIST"><block type="lexical_variable_get" id=")vl?Jt7PGdY?nc!%Le#f"><field name="VAR">global DescriptionsDe</field></block></value><value name="NUM"><block type="lexical_variable_get" id="t8]4a:^fLo6?}/M)r+st"><field name="VAR">global LocationBardoIndex</field></block></value></block></value></block></value></block></value></block></value><next><block type="component_set_get" id="Vg;:Zi#k%mX5n|s@3EUQ"><mutation component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Image1"></mutation><field name="COMPONENT_SELECTOR">Image1</field><field name="PROP">Picture</field><value name="VALUE"><block type="lists_select_item" id="D1,;23tBOcpNQ)cl~8HO"><value name="LIST"><block type="lexical_variable_get" id="F;.GzQ,b].tTDfqcg3cK"><field name="VAR">global Pictures</field></block></value><value name="NUM"><block type="lexical_variable_get" id="ZymRbLsvzAyavel){dES"><field name="VAR">global LocationBardoIndex</field></block></value></block></value></block></next></block></next></block></next></block></next></block></statement></block><block type="global_declaration" id="ysHu]:`zrh)c*2oJkUcL" x="-773" y="-786"><field name="NAME">Locations</field><value name="VALUE"><block type="lists_create_with" id="~mgihImG;*OZ7(dFP]--"><mutation items="8"></mutation><value name="ADD0"><block type="text" id="0|V);B)ovx86GUwM#~st"><field name="TEXT">Bardo</field></block></value><value name="ADD1"><block type="text" id="w2^Vpd[[?p@604=9w(+q"><field name="TEXT">Prosnid</field></block></value><value name="ADD2"><block type="text" id="t1*T6y|)-SX4}(HPpS?+"><field name="TEXT">Cerneu</field></block></value><value name="ADD3"><block type="text" id=".)xT_k$|@{.}3q7UD18R"><field name="TEXT">Tarcento</field></block></value><value name="ADD4"><block type="text" id="n5pHx56kOtrXU=td0`3j"><field name="TEXT">Canebola</field></block></value><value name="ADD5"><block type="text" id="~sb@cKpX:Bj8E_)G93@#"><field name="TEXT">Masarolis</field></block></value><value name="ADD6"><block type="text" id="o@SWtDV!CnbT|wXyJ92#"><field name="TEXT">Rezija</field></block></value><value name="ADD7"><block type="text" id="#ZP1D6(Q%v)Ji;vBNr6#"><field name="TEXT">Bila</field></block></value></block></value></block><block type="global_declaration" id="DQla2*^0@|a-WE6j|3^7" x="-757" y="-561"><field name="NAME">Pictures</field><value name="VALUE"><block type="lists_create_with" id="LrqiZN?mvr78Wvhb{/!r"><mutation items="8"></mutation><value name="ADD0"><block type="text" id="MzsfDPG]k=Fnf`y?tr8,"><field name="TEXT">BARDO(1).jpg</field></block></value><value name="ADD1"><block type="text" id="~x?I?X6Lj0r2{~TnE6rO"><field name="TEXT">prosnid.jpg</field></block></value><value name="ADD2"><block type="text" id="Q|u%bgbKto]L]i~6E]F%"><field name="TEXT">cergneu.jpg</field></block></value><value name="ADD3"><block type="text" id="HNMZx]H}#.rXheE1TCbZ"><field name="TEXT">tarcento.jpg</field></block></value><value name="ADD4"><block type="text" id="p=6QpO[20}|T0V2|v7}r"><field name="TEXT">canebola.jpg</field></block></value><value name="ADD5"><block type="text" id="XM##2mM^?k**zfpPD.g="><field name="TEXT">masarolisR.jpg</field></block></value><value name="ADD6"><block type="text" id="~/-56_ylzM*Uy]!J;q%N"><field name="TEXT">violini.jpg</field></block></value><value name="ADD7"><block type="text" id="uGUxP$![ADnQ]236)R-Z"><field name="TEXT">bila.jpg</field></block></value></block></value></block><block type="global_declaration" id="Mx9(FJ;aIdk%b6TJ$$vC" x="-796" y="-301"><field name="NAME">DescriptionsSi</field><value name="VALUE"><block type="lists_create_with" id="$7Wbt,C(]}v0`uIh{4#="><mutation items="8"></mutation><value name="ADD0"><block type="text" id="iLpFK^ts6My/RJ2PPY9c"><field name="TEXT">Na območju med izviroma Tera in Nadiže se pust predstavlja v obliki smešnih komedij, v katerih se norčujejo iz dobrih in slabih dogodkov prejšnjega leta. Vsak igralec se maskira v osebo, ki jo poustvarja.</field></block></value><value name="ADD1"><block type="text" id="||1lQ^RE88x7`vsM$T[o"><field name="TEXT">Pust začne že 6. januarja in konča s procesom in obsodbo pusta. Maske so se delile v lepe in grde. Sprevod je odpirala lepa maska v beli obleki in za njo so bili pejoner (blazina), pepejuker, plahutar, škapjer s kleščami in tabar, gozdni mož.</field></block></value><value name="ADD2"><block type="text" id="f=AdS0kwS$MC{C*7Nurh"><field name="TEXT">V Černjeji se pust prebudi vsako leto 5. januarja. Skupina ljudi,  se poda v jamo Cantun, kjer pusta rešijo verig. Glasen sprevod se ob soju bakel poda do kraja, kjer je pripravljen kres, imenovan palavin, ki ga nato sam Pust prižge.</field></block></value><value name="ADD3"><block type="text" id="m8y:I#*+`MyQf!.Qk*^R"><field name="TEXT">Tomàts so lesene maske, ki si jih nadenejo mladeniči, da se nato s satiričnimi opazkami, imenovanimi strîts, pošalijo z upravitelji in drugimi znanimi osebnostmi iz domače skupnosti. Značilne maske so izdelovali domači mojstri. </field></block></value><value name="ADD4"><block type="text" id="v8=Ld0ou36,D/q^~WP!5"><field name="TEXT">Iz Čanebole prihajata osrednja pustna lika: to sta curla, stara in grda žena, ter njen prav tako stari in grdi mož z grbo na hrbtu. Žena nosi ina hrbtu zvonce, pripete na ogrodje, ki je zelo podobno koši.</field></block></value><value name="ADD5"><block type="text" id="LNhYl;az{(h+/=N;q9L`"><field name="TEXT">Pust v Mažarolah predstavlja boj med dobrim in zlom. Te križnast z belo obleko in velikim pisanim pokrivalom v obliki križa lovi te kožnastega, odetega v ovčje kože. Spremljata ju dve ženski maski, minki, ki z metlo pometata pred njima. Te liepe so ženske maske, ki pobirajo darove.</field></block></value><value name="ADD6"><block type="text" id="!6nf8anGvj^KcZ)*)N@$"><field name="TEXT">Prvi nastop folklorne skupine “Val Resia” je bil v Vidmu že oktobra leta 1838. Od takrat naša folk rna skupina nosi po svetu rezijanski ples, pa seveda tudi rezijansko glasbo. Je noša ki predstavlja mlado, neporočeno, ki išče fanta: ta mlada nosi črno obleko (po rezijansko čamažot) in belo srajco. Pas in telovnik pa sta barvana. Na glavi ima s cvetjem pisano črno ruto.</field></block></value><value name="ADD7"><block type="text" id="Y4kzxa*hDFX?{|L5F5~0"><field name="TEXT">Značilne lipe bile maškire nosijo visok kolobuk, okrašeni z papirnatim rožam in zvončki. Babaci in kukaci pa oblečejo stare in obrabljene obleke. Plešejo ob igranju citire in bunkule, na pepelnico pa babaca obsodijo in zažgejo. </field></block></value></block></value></block><block type="component_event" id="/OZ`EvD[9/3n0/qZlV3b" x="140" y="-189"><mutation component_type="Button" is_generic="false" instance_name="BGallery" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BGallery</field><statement name="DO"><block type="component_set_get" id="nAjmJto16yz`cjX#Bp~`"><mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="ActivityStarter2"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter2</field><field name="PROP">DataUri</field><value name="VALUE"><block type="text_join" id="S/*(O1%jZ.i4./9AA_}|"><mutation items="2"></mutation><value name="ADD0"><block type="controls_choose" id="(Sz;%!E1H4##;[pfGnLr"><value name="TEST"><block type="math_compare" id="y/wR^;d1t/g[FRTMWp1:"><field name="OP">GTE</field><value name="A"><block type="lexical_variable_get" id="AQy+GB}BT(od%^zN^kkV"><field name="VAR">global LocationBardoIndex</field></block></value><value name="B"><block type="math_number" id="bZt[[T?[=]1B1@ke=|5]"><field name="NUM">7</field></block></value></block></value><value name="THENRETURN"><block type="text" id="yNrZsHL#U,XPXi.iUOE?"><field name="TEXT">https://example.org/pust-rezija/#</field></block></value><value name="ELSERETURN"><block type="text" id="(Ofpf0AYhttbLVUC4cfw"><field name="TEXT">https://example.org/pust-terska/#</field></block></value></block></value><value name="ADD1"><block type="lists_select_item" id="GG8#hdAL5(;yG-o^|/{F"><value name="LIST"><block type="lexical_variable_get" id="1,ievE+f)-ahq`t7eq!0"><field name="VAR">global Locations</field></block></value><value name="NUM"><block type="lexical_variable_get" id="/4wz)?f{}T^]be,;seTI"><field name="VAR">global LocationBardoIndex</field></block></value></block></value></block></value><next><block type="component_method" id="ha#!+r+00WQvc|dd/mmM"><mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="ActivityStarter2"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter2</field></block></next></block></statement></block><block type="global_declaration" id="[!2|h(`K,Oe)#5qo}5XQ" x="-783" y="-14"><field name="NAME">DescriptionsIt</field><value name="VALUE"><block type="lists_create_with" id="QsRmo@Fc)@oO-JI]k:mC"><mutation items="8"></mutation><value name="ADD0"><block type="text" id="$,IG0_o{tK{M/(`QHl.N"><field name="TEXT">Nel territorio tra le sorgenti del Torre e Natisone il tradizionale pust consiste nella rappresentazione di divertenti commedie che canzonano fatti e misfatti accaduti nel corso dell’anno passato. Ciascun attore si veste in base al personaggio da interpretare.</field></block></value><value name="ADD1"><block type="text" id="F`1=60I^)`Vsgp1q@;$Q"><field name="TEXT">I riti iniziano il 6 gennaio per terminare con il processo e la condanna del Pust. Tra le maschere, belle e brutte, ci sono la maschera bella vestita di bianco (te liepa), pejoner (materasso), pepejuker, (cenere), plahutar, che rappresentava la morte, škapjer con le tenaglie e tabar, (l’uomo dei boschi).</field></block></value><value name="ADD2"><block type="text" id="NB%!srO302uK|5zNIY6Y"><field name="TEXT">L’usanza del “risveglio” vede un gruppo di persone recarsi al Cantun e liberare il pust dalle catene. Ha poi inizio il rumoroso corteo, illuminato da torce infuocate, che raggiungerà il punto il cui è stato allestito il palavin, falò che viene ritualmente acceso dal pust stesso. </field></block></value><value name="ADD3"><block type="text" id="GwA8^(F[R^Th75F_5L^N"><field name="TEXT">I giovani dei paesi indossando i tomâts, le caratteristiche maschere di legno, si prendevano gioco, con gioiose satire, denominate gli strîts, degli amministratori o di altri personaggi noti della comunità locale. In genere i tomâts venivano realizzati dai mascherati stessi.</field></block></value><value name="ADD4"><block type="text" id="~|r{DNnJul7_}Rq=9#n!"><field name="TEXT">Le figure centrali sono una donna brutta e vecchia curla ed un uomo anch’esso brutto e vecchio chimato gobbo.  La figura femminile porta sulla schiena dei campanacci, che vengono fissati ad una particolare imbracatura molto simile ad una gerla.</field></block></value><value name="ADD5"><block type="text" id="7/l=|DQtADWNoV=%,=Qs"><field name="TEXT">Il pust di Masarolis rappresenta la lotta tra il bene e il male, tra il te Križnat con un copricapo fiorito a forma di croce, e il te kožnast vestito di pelli. Li accompagnano le minke, maschere femminili che con la scopa puliscono il percorso, e le te liepe, le belle, che raccolgono i doni.</field></block></value><value name="ADD6"><block type="text" id="M]}%@*Uinus)!/hYok~Z"><field name="TEXT">Il gruppo Folkloristico “Val Resia” sorge ufficialmente nel 1838. I costumi rappresentano: la giovane in cerca di marito, la donna sposata, la vedova, il giovane ed il signore facoltoso. Sono particolari i costumi delle “Lipe Bile Maškire/Le belle maschere bianche, utilizzati in valle durante il periodo di carnevale, costituiti da gonne bianche sovrapposte, nastri colorati e campanellini. Sul capo portano un pesante cappello realizzato con dei fiori di carta colorata.</field></block></value><value name="ADD7"><block type="text" id="^a@2?M-a~?rE/r_[Tc4r"><field name="TEXT">Alle lipe bile maškire vestite di bianco, con un cappello alto adorno di fiori di carta colorata e piccoli sonagli si contrappongono i babaci/kukaci, che indossano abiti vecchi e usati. Si balla al suono della citira e della bunkula e il giorno delle ceneri  si fa il processo e si brucia il babac.</field></block></value></block></value></block><block type="component_event" id="NW`GY~N~m}k-[DDKpg59" x="149" y="89"><mutation component_type="Button" is_generic="false" instance_name="BListen" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BListen</field><statement name="DO"><block type="component_method" id="gyhUJ@tKR.Nd/@R5OIsw"><mutation component_type="TextToSpeech" method_name="Speak" is_generic="false" instance_name="TextToSpeech1"></mutation><field name="COMPONENT_SELECTOR">TextToSpeech1</field><value name="ARG0"><block type="component_set_get" id="_F2nqv.#ZQ{J.#z1B97t"><mutation component_type="Label" set_or_get="get" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field></block></value></block></statement></block><block type="global_declaration" id="Vq*!;[StF5Vqn6]gC)]:" x="145" y="198"><field name="NAME">CurrentLocation</field><value name="VALUE"><block type="lists_create_with" id="tcIb$^}5Ph(|imAS2G!g"><mutation items="0"></mutation></block></value></block><block type="global_declaration" id="rC}-GAHk~k0_`{.KV{ec" x="-795" y="266"><field name="NAME">DescriptionsGb</field><value name="VALUE"><block type="lists_create_with" id="J_p~XS#wFo@M[_j*H;S~"><mutation items="8"></mutation><value name="ADD0"><block type="text" id="c-r=:tR:@OM]RVQg$fzW"><field name="TEXT">In the area between the sources of the Torre and Natisone, the traditional pust consists of the representation of amusing comedies that mock facts and misdeeds that occurred over the past year. Each actor dresses according to the character to be played.</field></block></value><value name="ADD1"><block type="text" id="*i7D|cXl0`$Gl.!B}.me"><field name="TEXT">The rites begin on January 6 to end with the trial and condemnation of the Pust. Among the masks, beautiful and ugly, there are the beautiful mask dressed in white (te liepa), pejoner (mattress), pepejuker, (ash), plahutar, which represented death, škapjer with pincers and tabar, (the man of the woods).</field></block></value><value name="ADD2"><block type="text" id="6:;mcG6!{cz^Up!9z-!$"><field name="TEXT">The custom of "awakening" sees a group of people go to Cantun and free the pust from its chains. Then begins the noisy procession, illuminated by flaming torches, which will reach the point where the palavin has been set up, a bonfire that is ritually lit by the pust itself.</field></block></value><value name="ADD3"><block type="text" id="6%kXr}qxNC+Eoyd#Gi}6"><field name="TEXT">The young people of the villages wearing the tomâts, the characteristic wooden masks, made fun of administrators or other well-known personalities of the local community with joyful satires, called the strîts. Usually the tomâts were made by the masked men themselves.</field></block></value><value name="ADD4"><block type="text" id="$m,.|Q/q}M77MKmnQ_#Q"><field name="TEXT">The central figures are an ugly and old curla woman and an ugly and old man called a hunchback. The female figure carries cowbells on her back, which are attached to a particular harness very similar to a pannier.</field></block></value><value name="ADD5"><block type="text" id="uXb{ah|]O!L4(,}jf6eY"><field name="TEXT">The Masarolis pust represents the struggle between good and evil, between the te Križnat with a floral headdress in the shape of a cross, and the te kožnast dressed in skins. They are accompanied by the minkas, female masks who clean the path with the broom, and the te liepe, the beautiful ones, who collect the gifts.</field></block></value><value name="ADD6"><block type="text" id="uh(i$Yy91jGxHO@|7g%F"><field name="TEXT">The “Val Resia” folk group officially rises in 1838. The costumes represent: the young woman looking for a husband, the married woman, the widow, the young man and the wealthy gentleman. The costumes of the “Lipe Bile Maškire / The beautiful white masks, used in the valley during the carnival period, consisting of overlapping white skirts, colored ribbons and little bells are particular. On their heads they wear a heavy hat made with colored paper flowers.</field></block></value><value name="ADD7"><block type="text" id="8C6IJ5vHzD/{LVW|;.])"><field name="TEXT">The lipe bile maškire dressed in white, with a high hat adorned with colored paper flowers and small rattles are contrasted by the babaci / kukaci, who wear old and used clothes. We dance to the sound of the citira and the bunkula and on the day of the ashes the trial is carried out and the babac is burned.</field></block></value></block></value></block><block type="global_declaration" id="`S7wY!rGLIa)tl2O+Wm!" x="146" y="242"><field name="NAME">DestinationAddress</field><value name="VALUE"><block type="text" id="OTYJs13Afo_QdM-Wuk;?"><field name="TEXT">46.05333522774499, 14.472003351834035</field></block></value></block><block type="component_event" id="nh_%~zV/UYyCy@$0sF60" x="148" y="294"><mutation component_type="Button" is_generic="false" instance_name="BNavigate" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BNavigate</field><statement name="DO"><block type="lexical_variable_set" id="w4Reu$x*[6,[-*ckD#61"><field name="VAR">global LocationBardoIndex</field><value name="VALUE"><block type="lists_position_in" id="]IK71!Xj`;]0bN=6@DMn"><value name="ITEM"><block type="component_method" id="XLeCRhQa$h$AP{[=qNLP"><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="jJ0Bph4%Q2ktb8|/}j|Y"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="o$Q]Fsp7=,RC.[g!3`tr"><field name="TEXT">Rodda</field></block></value></block></value><value name="LIST"><block type="lexical_variable_get" id="-!iwF|X%OL@x/pdmorw@"><field name="VAR">global Locations</field></block></value></block></value><next><block type="component_set_get" id="d3K*:EC3o/n$qhcZNG@e"><mutation component_type="ActivityStarter" set_or_get="set" property_name="Action" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field><field name="PROP">Action</field><value name="VALUE"><block type="text" id="NhRLols)m[DBTndI0D,/"><field name="TEXT">android.intent.action.VIEW</field></block></value><next><block type="component_set_get" id="3oYNX:lB]Ox3]h=BHJ)Q"><mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field><field name="PROP">DataUri</field><value name="VALUE"><block type="text_join" id="e4I;L6)qUBL[tiD%Vq##"><mutation items="2"></mutation><value name="ADD0"><block type="text" id="p|;zFhPA*M?JU1S9I,6P"><field name="TEXT">http://maps.google.com/maps/?daddr=</field></block></value><value name="ADD1"><block type="lists_select_item" id="q~77!whY+;6{l-!c=f82"><value name="LIST"><block type="lexical_variable_get" id=".l/^s)kJ@[H+PG:U]}4x"><field name="VAR">global Destinations</field></block></value><value name="NUM"><block type="lexical_variable_get" id=":HPJXk0.amj4sLz{/BP("><field name="VAR">global LocationBardoIndex</field></block></value></block></value></block></value><next><block type="component_method" id="F*Psli0FMoJ@WvoX7O19"><mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field></block></next></block></next></block></next></block></statement></block><block type="global_declaration" id="?-x:8.+-t9X8g_~t^JLs" x="-800" y="539"><field name="NAME">DescriptionsDe</field><value name="VALUE"><block type="lists_create_with" id="=b-^LKNdK2!E9eS-8]c]"><mutation items="8"></mutation><value name="ADD0"><block type="text" id="ch}FtA0hfiv5#;ByXgCO"><field name="TEXT">Im Bereich zwischen den Quellen des Torre und Natisone besteht die traditionelle Pust aus der Darstellung amüsanter Komödien, die sich über Tatsachen und Missetaten lustig machen, die im vergangenen Jahr aufgetreten sind. Jeder Schauspieler kleidet sich entsprechend dem zu spielenden Charakter.</field></block></value><value name="ADD1"><block type="text" id="S*n%D[=#@4,buXrbYpza"><field name="TEXT">Die Riten beginnen am 6. Januar und enden mit dem Prozess und der Verurteilung der Pust. Unter den Masken, schön und hässlich, gibt es die schöne Maske in Weiß (te liepa), Pejoner (Matratze), Pepejuker (Asche), Plahutar, die den Tod darstellte, škapjer mit Zangen und Tabar (der Mann des Waldes) ).</field></block></value><value name="ADD2"><block type="text" id="FMdI?629Edhjpgv@+t25"><field name="TEXT">Der Brauch des "Erwachens" sieht eine Gruppe von Menschen nach Cantun gehen und die Pust von ihren Ketten befreien. Dann beginnt die laute Prozession, die von brennenden Fackeln beleuchtet wird und den Punkt erreicht, an dem der Palavin aufgestellt wurde, ein Lagerfeuer, das von der Pust selbst rituell angezündet wird.</field></block></value><value name="ADD3"><block type="text" id="H^ueGnWDQ|h(?B4}DRVS"><field name="TEXT">Die jungen Leute der Dörfer, die die Tomâts, die charakteristischen Holzmasken, trugen, machten sich mit freudigen Satiren, sogenannten Strîts, über die Administratoren oder andere bekannte Persönlichkeiten der örtlichen Gemeinde lustig. Normalerweise wurden die Tome von den maskierten Männern selbst hergestellt.</field></block></value><value name="ADD4"><block type="text" id="iQzzfiX4/ez5y;q+;y|S"><field name="TEXT">Die zentralen Figuren sind eine hässliche und alte Curla-Frau und ein hässlicher und alter Mann, der Buckliger genannt wird. Die weibliche Figur trägt Kuhglocken auf dem Rücken, die an einem bestimmten Geschirr befestigt sind, das einem Koffer sehr ähnlich ist.</field></block></value><value name="ADD5"><block type="text" id="S9DxgckCIcDWaZ/:V|E0"><field name="TEXT">Die Masarolis-Pust repräsentiert den Kampf zwischen Gut und Böse, zwischen dem Te Križnat mit einem floralen Kopfschmuck in Form eines Kreuzes und dem Te Kožnast in Fellen. Sie werden begleitet von den Minkas, weiblichen Masken, die den Weg mit dem Besen reinigen, und den te liepe, den schönen, die Geschenke sammeln.</field></block></value><value name="ADD6"><block type="text" id="h;~@FdEQ14e~5|6p)1LR"><field name="TEXT">Die Volksgruppe „Val Resia“ erhebt sich 1838 offiziell. Die Kostüme repräsentieren: die junge Frau, die einen Ehemann sucht, die verheiratete Frau, die Witwe, den jungen Mann und den reichen Herrn. Besonders hervorzuheben sind die Kostüme der „Lipe Bile Maškire / Die schönen weißen Masken, die während des Karnevals im Tal verwendet wurden und aus überlappenden weißen Röcken, farbigen Bändern und Glöckchen bestehen. Auf ihren Köpfen tragen sie einen schweren Hut aus farbigen Papierblumen.</field></block></value><value name="ADD7"><block type="text" id="Ta4X7n0|){u#~pjUgzWr"><field name="TEXT">Die Babaci / Kukaci, die alte und gebrauchte Kleidung tragen, kontrastieren die weiß gekleidete Lipe Galle Maškire mit einem hohen Hut, der mit farbigen Papierblumen und kleinen Rasseln geschmückt ist. Wir tanzen zum Klang der Citira und der Bunkula und am Tag der Asche wird der Prozess durchgeführt und der Babac verbrannt.</field></block></value></block></value></block><block type="global_declaration" id="A~4jpRJ@y/FyoQ;Q=heY" x="161" y="657"><field name="NAME">Destinations</field><value name="VALUE"><block type="lists_create_with" id="BLKNpEVc8?$K*d`tr+uT"><mutation items="8"></mutation><value name="ADD0"><block type="text" id="NwPB4!D71cWm^!$O~iz6"><field name="TEXT">46.2758218,13.2672159</field></block></value><value name="ADD1"><block type="text" id="c2vNR]fOYgHzL-CW4ke$"><field name="TEXT">46.2264276,13.4018794</field></block></value><value name="ADD2"><block type="text" id="y]1Lmc+*O0HsQqa@wY4g"><field name="TEXT">46.2153755,13.3091015</field></block></value><value name="ADD3"><block type="text" id="i%0qOTIjB0pcdGOg)F.,"><field name="TEXT">46.215273,13.2216583</field></block></value><value name="ADD4"><block type="text" id="xCd@jt@Y*,NPtobMaId,"><field name="TEXT">46.1794397,13.3813877</field></block></value><value name="ADD5"><block type="text" id="wh)Hr.j8pfjz4;*|yu#("><field name="TEXT">46.1727892,13.4273307</field></block></value><value name="ADD6"><block type="text" id="5s5(tx~D]ey1{6dfE?m!"><field name="TEXT">46.3614343,13.3541072</field></block></value><value name="ADD7"><block type="text" id="2hP5M9ZZ)`kBIi63(zXi"><field name="TEXT">46.3776044,13.2860707</field></block></value></block></value></block><block type="component_event" id="^nj:URf::{MQPF6n*VaS" x="-381" y="851"><mutation component_type="Button" is_generic="false" instance_name="BBack" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BBack</field><statement name="DO"><block type="controls_closeScreen" id=")}ja-9C9`PdzwIE;V=4U"></block></statement></block><yacodeblocks ya-version="221" language-version="36"></yacodeblocks></xml>