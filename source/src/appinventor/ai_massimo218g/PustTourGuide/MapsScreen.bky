et_get" id="a(|X;.L4(EG|V:bW9@sl"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="InstructionLabel"></mutation><field name="COMPONENT_SELECTOR">InstructionLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="lists_select_item" id="I3W}g6j2*hbKLL+i8mQC"><value name="LIST"><block type="lexical_variable_get" id="+JXk#JusZceRY9gv5u!n"><field name="VAR">global InstructionText</field></block></value><value name="NUM"><block type="lexical_variable_get" id="~j$#8((#EiM1(ing11X_"><field name="VAR">global MapsScreenIndex</field></block></value></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="global_declaration" id="ysHu]:`zrh)c*2oJkUcL" x="-906" y="-654"><field name="NAME">Maps</field><value name="VALUE"><block type="lists_create_with" id="~mgihImG;*OZ7(dFP]--"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="0|V);B)ovx86GUwM#~st"><field name="TEXT">Si</field></block></value><value name="ADD1"><block type="text" id="w2^Vpd[[?p@604=9w(+q"><field name="TEXT">It</field></block></value><value name="ADD2"><block type="text" id="t1*T6y|)-SX4}(HPpS?+"><field name="TEXT">Gb</field></block></value><value name="ADD3"><block type="text" id=".)xT_k$|@{.}3q7UD18R"><field name="TEXT">De</field></block></value></block></value></block><block type="global_declaration" id="4#J$M3co-@.9a_7USF2@" x="-925" y="-534"><field name="NAME">RoddaText</field><value name="VALUE"><block type="lists_create_with" id="mCZaei5wUmc.Px`O`VW+"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="ibrVTi}{^Z(Eh,m08J5w"><field name="TEXT">Značilnosti Roddinega Pustja sta hudič "zluodij" in "Agnulaz", angel Michael, ki ga skuša zadržati v zalivu.</field></block></value><value name="ADD1"><block type="text" id="#}t;A)(ap]+rV?n|R3@G"><field name="TEXT">Sono caratteristiche del Pust di Rodda, il diavolo “zluodij” e l’”Agnulaz”, l’angelo Michele che tenta di tenerlo a bada.</field></block></value><value name="ADD2"><block type="text" id="zvd1=UOy766UpENY`bml"><field name="TEXT">Characteristics of Rodda's Pust are the devil "zluodij" and the "Agnulaz", the angel Michael who tries to keep him at bay.</field></block></value><value name="ADD3"><block type="text" id="-Jom7kiH#}xk#L9FKYhb"><field name="TEXT">Merkmale von Roddas Pust sind der Teufel "zluodij" und der "Agnulaz", der Engel Michael, der versucht, ihn in Schach zu halten.</field></block></value></block></value></block><block type="global_declaration" id="F^i%7vmUp#_}F4OQi,i9" x="-915" y="-425"><field name="NAME">MersinoText</field><value name="VALUE"><block type="lists_create_with" id="~UJodz=e*i}4(#|u;/+}"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="Ndk*@R6+,NrjDT/^S[2D"><field name="TEXT">Povorki sledijo liki Petelina in Kokoši, prekriti z barvnimi cunjami</field></block></value><value name="ADD1"><block type="text" id="0/VEKx`s:!0/){-!m3GD"><field name="TEXT">Il corteo è seguito dalle figure del Gallo e della Gallina, ricoperte di stracci colorati</field></block></value><value name="ADD2"><block type="text" id="NU(m91Jbx71SeU8MGHVw"><field name="TEXT">The procession is followed by the figures of the Rooster and the Hen, covered with colored rags</field></block></value><value name="ADD3"><block type="text" id="E`J$7FkQqfY,W`Qzl{}c"><field name="TEXT">Der Prozession folgen die mit farbigen Lumpen bedeckten Figuren des Hahns und der Henne</field></block></value></block></value></block><block type="global_declaration" id="3E[._`gY/NSr7C+wl[NR" x="-916" y="-311"><field name="NAME">MontefoscaText</field><value name="VALUE"><block type="lists_create_with" id="=SY5c[w%D~7sQ/[;mHtu"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="Ill|tx2JrCkyeytZiaJJ"><field name="TEXT">Blumarji so značilni za mesto Montefosca.</field></block></value><value name="ADD1"><block type="text" id="j$x?d.OwJX%Vg!vBjqz!"><field name="TEXT">I Blumarji sono tipici del paese di Montefosca. </field></block></value><value name="ADD2"><block type="text" id="][ph;0|vq/%qWEQ,[2S4"><field name="TEXT">The Blumarji are typical of the town of Montefosca.</field></block></value><value name="ADD3"><block type="text" id="n!QL,U#$GdAS%KRD*#Sd"><field name="TEXT">Die Blumarji sind typisch für die Stadt Montefosca.</field></block></value></block></value></block><block type="global_declaration" id="-Ed%U%gh9^0_.+L2%yNS" x="-931" y="-187"><field name="NAME">MatajurText</field><value name="VALUE"><block type="lists_create_with" id="Ums7l_KJ}}GG^MB:+}R4"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="OJc6P7-y]e4HX^.oM}`N"><field name="TEXT">Značilne skupine Pust so skupine grdih, "te gardi" in lepih "te liepi"</field></block></value><value name="ADD1"><block type="text" id="etCPOeI.uRW6+~p_JwS7"><field name="TEXT">Tipiche di questo Pust  sono i gruppi dei brutti, “te gardi” e dei belli, “te liepi"</field></block></value><value name="ADD2"><block type="text" id="V}sJBU9$T`IL6ejfJ2vj"><field name="TEXT">Typical of this Pust are the groups of the ugly, "te gardi" and the beautiful, "te liepi"</field></block></value><value name="ADD3"><block type="text" id="%ud{1AS^vjXl=03q8*Mu"><field name="TEXT">Typisch für diesen Pust sind die Gruppen der hässlichen "te gardi" und der schönen "te liepi"</field></block></value></block></value></block><block type="component_event" id="76e}oPQGsx/?MOIX8rk:" x="-95" y="-186"><mutation component_type="Marker" is_generic="false" instance_name="Mersino" event_name="LongClick"></mutation><field name="COMPONENT_SELECTOR">Mersino</field><statement name="DO"><block type="component_method" id="HMIS@/^,J@hQD:mMO;U0"><mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="-D7H00B#BCc9_tIx4b$*"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id=")m2Juim}3;G6EEK+a`H="><field name="TEXT">Mersino</field></block></value><next><block type="controls_openAnotherScreen" id="nV|8RYAR0fMW,/Mn9KAG"><value name="SCREEN"><block type="helpers_screen_names" id="L9LrrjhD`^I2(}4K`D}f"><field name="SCREEN">LocationScreen</field></block></value></block></next></block></statement></block><block type="global_declaration" id="LIne_%O.5cJ-tv7D]Oze" x="-919" y="-68"><field name="NAME">ClodigText</field><value name="VALUE"><block type="lists_create_with" id="1}j2c[FMMWEB2M`m;xud"><mutation items="4"></mutation><value name="ADD0"><block type="text" id=".|2_Y-4UKv+nT7Mt,R8X"><field name="TEXT">Značilnost Clodigovih mask je, da so nekatere narejene iz protja.</field></block></value><value name="ADD1"><block type="text" id="*)*kq~fEMVS5uk**$=Fr"><field name="TEXT">La caratteristica delle maschere di Clodig è data dal fatto che alcune sono realizzate in vimini. </field></block></value><value name="ADD2"><block type="text" id="+VK{}+D69D9f{P.:/{ML"><field name="TEXT">The characteristic of Clodig masks is that some are made of wicker.</field></block></value><value name="ADD3"><block type="text" id="P!/YH[TRR1[ipAx!ZvwX"><field name="TEXT">Das Merkmal von Clodig-Masken ist, dass einige aus Weide bestehen.</field></block></value></block></value></block><block type="component_event" id="/`=Aoq;$^GFSt^1k-vY%" x="358" y="-112"><mutation component_type="Marker" is_generic="false" instance_name="Stregna" event_name="LongClick"></mutation><field name="COMPONENT_SELECTOR">Stregna</field><statement name="DO"><block type="component_method" id="kf!(t.3S8.5VTC,{@~u+"><mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="hc1Y:CMQ@J2a}?G_JaO:"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="_^)S|@n0~T.Wmr*+uvy7"><field name="TEXT">Stregna</field></block></value><next><block type="controls_openAnotherScreen" id="@j*Zpg!82Hcm7jS_#1TV"><value name="SCREEN"><block type="helpers_screen_names" id="^Y:TgM9[y#!|f28B8SA8"><field name="SCREEN">LocationScreen</field></block></value></block></next></block></statement></block><block type="component_event" id="i-`6G:-{Yin`Sp~~t+yG" x="-98" y="-29"><mutation component_type="Marker" is_generic="false" instance_name="Rodda" event_name="LongClick"></mutation><field name="COMPONENT_SELECTOR">Rodda</field><statement name="DO"><block type="component_method" id="R,EsiL#-3P%`RW[1HX12"><mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="}$yc!ziT|EjuDr|P=SR7"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="hkZs$yfUp51-4-$ki2dC"><field name="TEXT">Rodda</field></block></value><next><block type="controls_openAnotherScreen" id="`[o%T4;:_UJR*38Jd%{)"><value name="SCREEN"><block type="helpers_screen_names" id="mQGh+k@(|62^s;n*(46y"><field name="SCREEN">LocationScreen</field></block></value></block></next></block></statement></block><block type="global_declaration" id=".,E6aW^?r9);.[#egU=a" x="-918" y="66"><field name="NAME">AzzidaText</field><value name="VALUE"><block type="lists_create_with" id="XQ)3;`]m@9AV8Vuz!J7p"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="k+^t+ra|+avEf9QCRAq0"><field name="TEXT">Krava</field></block></value><value name="ADD1"><block type="text" id="hdxZ]RTmERb+2CB(+3D9"><field name="TEXT">La mucca</field></block></value><value name="ADD2"><block type="text" id="lhis#wN5gMsq/]w0gRV8"><field name="TEXT">The cow</field></block></value><value name="ADD3"><block type="text" id="l2u+RrdqO7;h2@o5~R=i"><field name="TEXT">Die Kuh</field></block></value></block></value></block><block type="component_event" id="LHvBXBM1s$s[{-({B)(s" x="360" y="57"><mutation component_type="Marker" is_generic="false" instance_name="Clodig" event_name="LongClick"></mutation><field name="COMPONENT_SELECTOR">Clodig</field><statement name="DO"><block type="component_method" id="4lK1eUxiVxk!FwXBlVy_"><mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="Sg[l|bou!*Z?#cZ)*T=J"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="1kiz*:YPv.GdusF:.iij"><field name="TEXT">Clodig</field></block></value><next><block type="controls_openAnotherScreen" id="+EjNTtI[^@Yt4OkeD|k8"><value name="SCREEN"><block type="helpers_screen_names" id="TtQz,)DDH4tfruo!D{RZ"><field name="SCREEN">LocationScreen</field></block></value></block></next></block></statement></block><block type="component_event" id="(nBf[pSFOa)NVX_jEr:!" x="-92" y="122"><mutation component_type="Marker" is_generic="false" instance_name="Montefosca" event_name="LongClick"></mutation><field name="COMPONENT_SELECTOR">Montefosca</field><statement name="DO"><block type="component_method" id="0QvN9(t$foU+(}JI|)aF"><mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="([a[|j;Z}%S=l4lT)Sa@"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="LW#G`Lef~Mkb+a]qcVM2"><field name="TEXT">Montefosca</field></block></value><next><block type="controls_openAnotherScreen" id="mKE:H,r]Z5lz,GqIFZYc"><value name="SCREEN"><block type="helpers_screen_names" id="+M+InJq*(0~r)2hi4FDR"><field name="SCREEN">LocationScreen</field></block></value></block></next></block></statement></block><block type="global_declaration" id="6QY2ip.UT7s}r^yiFCOg" x="-919" y="178"><field name="NAME">StregnaText</field><value name="VALUE"><block type="lists_create_with" id="v(~c.A.:_S~?hV}]!ojb"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="*5cGl;2=Yka6-itJ.K@9"><field name="TEXT">Tipične maske občine Stregna so: Veliki Pust, Skapiač in Pustje.</field></block></value><value name="ADD1"><block type="text" id="VS$DiyOev3MWI?VXUk^v"><field name="TEXT">Le maschere tipiche del comune di Stregna sono : il Veliki Pust, lo Skapiač e i Pustje. </field></block></value><value name="ADD2"><block type="text" id="RDf;!gb)m?CXHTUuR!/5"><field name="TEXT">The typical masks of the municipality of Stregna are: the Veliki Pust, the Skapiač and the Pustje.</field></block></value><value name="ADD3"><block type="text" id="|RhOp![En9@@VF0_Vx)%"><field name="TEXT">Die typischen Masken der Gemeinde Stregna sind: die Veliki Pust, die Skapiač und die Pustje.</field></block></value></block></value></block><block type="component_event" id="8ddZd@HQOR~fEO33Y(J%" x="398" y="235"><mutation component_type="Marker" is_generic="false" instance_name="Azzida" event_name="LongClick"></mutation><field name="COMPONENT_SELECTOR">Azzida</field><statement name="DO"><block type="component_method" id="$NLpDb2zKzLLJ;c,IW$y"><mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="s6=-NM~h*-RPMOOCI(JD"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="|{0*`E({`)5~cMm2UGXA"><field name="TEXT">Azzida</field></block></value><next><block type="controls_openAnotherScreen" id="9tNpOg|vmg!y^/zW:haL"><value name="SCREEN"><block type="helpers_screen_names" id="4w_Tt4?HMl^dRY4c?,kS"><field name="SCREEN">LocationScreen</field></block></value></block></next></block></statement></block><block type="global_declaration" id="fLZ9_W.50j.#B.^^zDDX" x="-957" y="315"><field name="NAME">InstructionText</field><value name="VALUE"><block type="lists_create_with" id="2i5%d#MlP1Zo)O`el.@D"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="L@akZx%)u]eL!siW=_D!"><field name="TEXT">Za informacije kliknite oznako. Dolgo kliknite za več podrobnosti o lokaciji.</field></block></value><value name="ADD1"><block type="text" id="R~6Ojv-h6+e?1[jQ5Q_z"><field name="TEXT">Fare clic su un marker per le informazioni. Tenere premuto per maggiori dettagli su una posizione.</field></block></value><value name="ADD2"><block type="text" id="-s.kiq+`d9KX9@:FWVbY"><field name="TEXT">Click on a marker for information. Long-click for more detail on a location.</field></block></value><value name="ADD3"><block type="text" id="D!I}1hbV)STQp2Kb*xOc"><field name="TEXT">Klicken Sie auf eine Markierung, um Informationen zu erhalten. Klicken Sie lange, um weitere Informationen zu einem Standort zu erhalten.</field></block></value></block></value></block><block type="component_event" id="{6/0-L+NnW}J=I1,Qq-A" x="-80" y="279"><mutation component_type="Marker" is_generic="false" instance_name="Matajur" event_name="LongClick"></mutation><field name="COMPONENT_SELECTOR">Matajur</field><statement name="DO"><block type="component_method" id="@oRnh1d363e_;L,8.NYJ"><mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="OJuX0QFg4?%z,tMZPyYV"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="e=rMr_Lw^p-,#J~H[HPz"><field name="TEXT">Matajur</field></block></value><next><block type="controls_openAnotherScreen" id="-la_OXV/kPW?vt^,coq5"><value name="SCREEN"><block type="helpers_screen_names" id="R%zDRjA;!e9`k@Z/~!yO"><field name="SCREEN">LocationScreen</field></block></value></block></next></block></statement></block><block type="component_event" id="$b#?$vTA}Wg$QTN?`k[7" x="-92" y="561"><mutation component_type="Button" is_generic="false" instance_name="bHome" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">bHome</field><statement name="DO"><block type="controls_closeScreen" id="?0#dCRt*],wUsx@AW?{3"></block></statement></block><yacodeblocks ya-version="221" language-version="36"></yacodeblocks></xml>