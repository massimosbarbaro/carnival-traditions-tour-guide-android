<xml xmlns="http://www.w3.org/1999/xhtml"><block type="global_declaration" id="Q4`wIYflThvhFmJ[Vtbi" x="-154" y="-1086"><field name="NAME">LocationsNames</field><value name="VALUE"><block type="lists_create_with" id="NDdGKx,z3iRJQ4?)HXG2"><mutation items="7"></mutation><value name="ADD0"><block type="text" id=".6/!V*bOv~$A8cm`_oIl"><field name="TEXT">Ruonac - Rodda</field></block></value><value name="ADD1"><block type="text" id="2Qfi:66]UK%tqDmdg8eO"><field name="TEXT">Marsin - Mersino</field></block></value><value name="ADD2"><block type="text" id="Y0T,$,8-1a#eV!(hO`y|"><field name="TEXT">Čarnivarh - Montefosca</field></block></value><value name="ADD3"><block type="text" id="j?M$4mxOID,^WIx:rcn4"><field name="TEXT">Matajur</field></block></value><value name="ADD4"><block type="text" id="Jq^//K};bMc0~0$a!S/W"><field name="TEXT">Hlocje - Clodig</field></block></value><value name="ADD5"><block type="text" id="X$UEu{J?P~m#d`;Uiq6D"><field name="TEXT">Ažla - Azzida</field></block></value><value name="ADD6"><block type="text" id="U~#S1jA$rB)RS9eAX`Qk"><field name="TEXT">Sriednje - Stregna</field></block></value></block></value></block><block type="global_declaration" id="]xW5~2@TtP@+]E0{Io%|" x="-775" y="-1021"><field name="NAME">LanguageScreenIndex</field><value name="VALUE"><block type="lists_create_with" id="F/aWv*;Dr`]ER?T{~W.#"><mutation items="4"></mutation><value name="ADD0"><block type="text" id="27uKx3smA/F@`=X?(Anj"><field name="TEXT">Si</field></block></value><value name="ADD1"><block type="text" id="2]7/aD26zOBnp!sWH-w4"><field name="TEXT">It</field></block></value><value name="ADD2"><block type="text" id="H966j%kt)tQYKb.2ixBm"><field name="TEXT">Gb</field></block></value><value name="ADD3"><block type="text" id="(DsqysU}xOvMx5_~MAfT"><field name="TEXT">De</field></block></value></block></value></block><block type="global_declaration" id="ZN|Ljgd!.L?ju/N)b+Fc" x="-786" y="-815"><field name="NAME">LocationScreenIndex</field><value name="VALUE"><block type="math_number" id=",CVgf{,Qu@%nJW8dOo5_"><field name="NUM">0</field></block></value></block><block type="component_event" id="2!:4mpk6NK3w8ESESx}e" x="100" y="-841"><mutation component_type="Form" is_generic="false" instance_name="LocationScreen" event_name="Initialize"></mutation><field name="COMPONENT_SELECTOR">LocationScreen</field><statement name="DO"><block type="lexical_variable_set" id="__aCR/{A(X(2/M2G(X/h"><field name="VAR">global LocationScreenIndex</field><value name="VALUE"><block type="lists_position_in" id="8UStZzh!7u[=H3`](J*Z"><value name="ITEM"><block type="component_method" id="UX}y==2($,Jx%?H?HahF"><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="OeJ0O5gZ*3DPtj8qp)1z"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="Xk]@bm@^B4/p*tT1KAH5"><field name="TEXT">Rodda</field></block></value></block></value><value name="LIST"><block type="lexical_variable_get" id="IxmH(d|w{ZJBb*o_TSz8"><field name="VAR">global Locations</field></block></value></block></value><next><block type="lexical_variable_set" id=",Tf7JfON[zK3vCqXukVy"><field name="VAR">global LanguageScreenIndex</field><value name="VALUE"><block type="component_method" id="?LQsy*GMFvWE$,4ZKe5="><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="4L/W],[X8YB5@5bC^{9t"><field name="TEXT">Language</field></block></value><value name="ARG1"><block type="text" id="BpvlA+T{|V=UFEUvlM!%"><field name="TEXT">Si</field></block></value></block></value><next><block type="component_set_get" id="7=Ao;z$:q+ftLkXK|-}H"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="LocationLabel"></mutation><field name="COMPONENT_SELECTOR">LocationLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="lists_select_item" id="Y9NjeZ4K6u]nLTi7W!(x"><value name="LIST"><block type="lexical_variable_get" id="A:Z(~0N;BE9|cM]R^f|i"><field name="VAR">global LocationsNames</field></block></value><value name="NUM"><block type="lexical_variable_get" id="_FpdZ=npv@+vB7tgz#I;"><field name="VAR">global LocationScreenIndex</field></block></value></block></value><next><block type="component_set_get" id="v$6b9Z;cWn-:D80ix/}u"><mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field><value name="VALUE"><block type="controls_choose" id="GOpr^r?cwWr-8VPYaFbs"><value name="TEST"><block type="text_compare" id="oQZod?Dy624-I}|enWI4"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="]Ee4qs!So[f[aB-c^3|e"><field name="VAR">global LanguageScreenIndex</field></block></value><value name="TEXT2"><block type="text" id="zUEn*v{%Yk9XgwBI{)9J"><field name="TEXT">Si</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id="2B+Zjp`7tj1{z+Q!YSfx"><value name="LIST"><block type="lexical_variable_get" id="V.){b$:5292Nv7DG5^vo"><field name="VAR">global DescriptionsSi</field></block></value><value name="NUM"><block type="lexical_variable_get" id="!Q3wTihe8L?n$f*m(P.4"><field name="VAR">global LocationScreenIndex</field></block></value></block></value><value name="ELSERETURN"><block type="controls_choose" id="-3eq5(/wI)rn5PZe.G!t"><value name="TEST"><block type="text_compare" id="YgiHRi7fV,0L$/2vhdxt"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="Qm*S?xq3~;gUw364W*iL"><field name="VAR">global LanguageScreenIndex</field></block></value><value name="TEXT2"><block type="text" id="1s@BEDB^S+gNf@tm^ksh"><field name="TEXT">It</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id=":5c^BR3#r,:O`jPuzi)0"><value name="LIST"><block type="lexical_variable_get" id="TD|dRTGWpI+B;v=.9}RH"><field name="VAR">global DescriptionsIt</field></block></value><value name="NUM"><block type="lexical_variable_get" id="~;2bvMD-;mP%b;{KXl]."><field name="VAR">global LocationScreenIndex</field></block></value></block></value><value name="ELSERETURN"><block type="controls_choose" id="4NhCo`zKsImBZr%y_KP6"><value name="TEST"><block type="text_compare" id="mbvWypL8X|BNUKL](wki"><field name="OP">EQUAL</field><value name="TEXT1"><block type="lexical_variable_get" id="xvM@8=MP{C@+$yQ!QE,D"><field name="VAR">global LanguageScreenIndex</field></block></value><value name="TEXT2"><block type="text" id="y;4:-I|4;b[#mKUk_#|i"><field name="TEXT">Gb</field></block></value></block></value><value name="THENRETURN"><block type="lists_select_item" id=":@#$%[%1QiJ+/G`XovCc"><value name="LIST"><block type="lexical_variable_get" id="KC-}9HZMz9[auO;};nEK"><field name="VAR">global DescriptionsGb</field></block></value><value name="NUM"><block type="lexical_variable_get" id="ejsT}wQZh:I3FqB!N|^%"><field name="VAR">global LocationScreenIndex</field></block></value></block></value><value name="ELSERETURN"><block type="lists_select_item" id="BjdHN!JA2IsJvCuGBGR."><value name="LIST"><block type="lexical_variable_get" id=")vl?Jt7PGdY?nc!%Le#f"><field name="VAR">global DescriptionsDe</field></block></value><value name="NUM"><block type="lexical_variable_get" id="t8]4a:^fLo6?}/M)r+st"><field name="VAR">global LocationScreenIndex</field></block></value></block></value></block></value></block></value></block></value><next><block type="component_set_get" id="Vg;:Zi#k%mX5n|s@3EUQ"><mutation component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Image1"></mutation><field name="COMPONENT_SELECTOR">Image1</field><field name="PROP">Picture</field><value name="VALUE"><block type="lists_select_item" id="D1,;23tBOcpNQ)cl~8HO"><value name="LIST"><block type="lexical_variable_get" id="F;.GzQ,b].tTDfqcg3cK"><field name="VAR">global Pictures</field></block></value><value name="NUM"><block type="lexical_variable_get" id="ZymRbLsvzAyavel){dES"><field name="VAR">global LocationScreenIndex</field></block></value></block></value></block></next></block></next></block></next></block></next></block></statement></block><block type="global_declaration" id="ysHu]:`zrh)c*2oJkUcL" x="-787" y="-763"><field name="NAME">Locations</field><value name="VALUE"><block type="lists_create_with" id="~mgihImG;*OZ7(dFP]--"><mutation items="7"></mutation><value name="ADD0"><block type="text" id="0|V);B)ovx86GUwM#~st"><field name="TEXT">Rodda</field></block></value><value name="ADD1"><block type="text" id="w2^Vpd[[?p@604=9w(+q"><field name="TEXT">Mersino</field></block></value><value name="ADD2"><block type="text" id="t1*T6y|)-SX4}(HPpS?+"><field name="TEXT">Montefosca</field></block></value><value name="ADD3"><block type="text" id=".)xT_k$|@{.}3q7UD18R"><field name="TEXT">Matajur</field></block></value><value name="ADD4"><block type="text" id="n5pHx56kOtrXU=td0`3j"><field name="TEXT">Clodig</field></block></value><value name="ADD5"><block type="text" id="~sb@cKpX:Bj8E_)G93@#"><field name="TEXT">Azzida</field></block></value><value name="ADD6"><block type="text" id="AGU5okSQjhyX-??n-5G8"><field name="TEXT">Stregna</field></block></value></block></value></block><block type="global_declaration" id="DQla2*^0@|a-WE6j|3^7" x="-786" y="-565"><field name="NAME">Pictures</field><value name="VALUE"><block type="lists_create_with" id="LrqiZN?mvr78Wvhb{/!r"><mutation items="7"></mutation><value name="ADD0"><block type="text" id="MzsfDPG]k=Fnf`y?tr8,"><field name="TEXT">roddaR.jpg</field></block></value><value name="ADD1"><block type="text" id="~x?I?X6Lj0r2{~TnE6rO"><field name="TEXT">mersinor.jpg</field></block></value><value name="ADD2"><block type="text" id="Q|u%bgbKto]L]i~6E]F%"><field name="TEXT">blumariR.jpg</field></block></value><value name="ADD3"><block type="text" id="HNMZx]H}#.rXheE1TCbZ"><field name="TEXT">matajurR.jpg</field></block></value><value name="ADD4"><block type="text" id="p=6QpO[20}|T0V2|v7}r"><field name="TEXT">clodigR.jpg</field></block></value><value name="ADD5"><block type="text" id="XM##2mM^?k**zfpPD.g="><field name="TEXT">azz.jpg</field></block></value><value name="ADD6"><block type="text" id="JE(tG-:4qEPK[45M{^wt"><field name="TEXT">StregnaR.jpg</field></block></value></block></value></block><block type="global_declaration" id="Mx9(FJ;aIdk%b6TJ$$vC" x="-794" y="-369"><field name="NAME">DescriptionsSi</field><value name="VALUE"><block type="lists_create_with" id="$7Wbt,C(]}v0`uIh{4#="><mutation items="7"></mutation><value name="ADD0"><block type="text" id="iLpFK^ts6My/RJ2PPY9c"><field name="TEXT">Poleg  pusta, ki z zvonenjem naznanja prihod pustne skupine, sta značilni maski zluodij, črno oblečen hudič s strašno leseno masko in rogovi ter z vilami v rokah, in anjulac, ki ga drži  na verigi in tako prepreči najhujše. </field></block></value><value name="ADD1"><block type="text" id="||1lQ^RE88x7`vsM$T[o"><field name="TEXT">Skupino odpiraji pustje  z raztegljivimi kleščami in kravjimi zvonci okrog pasu, sledita jim petelin in kokoš ter vrsta drugih mask: žena, ki nosi sina ali moža v košu, ta stara dva, berač, ki pobira darove, in pari te liepih.</field></block></value><value name="ADD2"><block type="text" id="f=AdS0kwS$MC{C*7Nurh"><field name="TEXT">Blumarji so belo oblečeni, na hrbtu imajo obešene zvonce, na glavi pa visok vejnat klobuk. V rokah imajo dolgo palico (pištok) in  tečejo okrog vasi tolikokrat, kolikor jih je (število je vedno liho).</field></block></value><value name="ADD3"><block type="text" id="m8y:I#*+`MyQf!.Qk*^R"><field name="TEXT">Pustje iz Matajurja so prav tako lepi in grdi. Te grdi imajo s sajami namazan obraz in visok šilast klobuk, strgane in s trakovi obšite obleke, opremljeni so s kravjimi zvonci in palicami. Lepih mask je šest, tri ženske in tri moške. Njihovi klobuki so prekriti s papirnatimi rožami.</field></block></value><value name="ADD4"><block type="text" id="v8=Ld0ou36,D/q^~WP!5"><field name="TEXT">Značilnost tega pusta so obleke, spletene iz vrbovih šib. Na čelu sprevoda hodijo maske, ki naznajajo pust, sledi par starcev, ki nosita košare in nabirata darove. Sledijo konj, medved, krava petelin in druge živali in na koncu še smrt s koso in stara Terezija, ki nosi v košu Vanaca.</field></block></value><value name="ADD5"><block type="text" id="LNhYl;az{(h+/=N;q9L`"><field name="TEXT">Že od dvajsetih let so Ažlanji imeli Kravo za simbol Pusta. V tistih letih so v Ažli menda imeli več krav kot ljudi. Jih je bilo veliko in to v vsakem hlevu. Za kmete je krava, s svojim mlekom, simbol plodnosti in materinstva. Za ljudi iz Ažle, kot tudi iz vseh dolin, je bila prvi vir denarja in hrane.</field></block></value><value name="ADD6"><block type="text" id="SejzirV8pAL+]eW[OyNq"><field name="TEXT">Veliki pust vodi skupino, sledijo mu škapjač z raztegljivimi kleščami in pustje. Med lepimi maskami so kralj in kraljica, noviči, lepo oblečeni pari s klobuki, ki jih krasijo papirnate rože, grde pa so opremljene z nogavicami, polnimi saj in pepela.</field></block></value></block></value></block><block type="global_declaration" id="[!2|h(`K,Oe)#5qo}5XQ" x="-800" y="-161"><field name="NAME">DescriptionsIt</field><value name="VALUE"><block type="lists_create_with" id="QsRmo@Fc)@oO-JI]k:mC"><mutation items="7"></mutation><value name="ADD0"><block type="text" id="$,IG0_o{tK{M/(`QHl.N"><field name="TEXT">Oltre alla maschera del pust che apre il corteo, sono caratteristici il diavolo, zluodij, tutto nero con la maschera lignea con due grandi corna e la forca in mano, l’anjulac, l’angelo Michele che tenta di tenerlo a bada con una robusta catena.</field></block></value><value name="ADD1"><block type="text" id="F`1=60I^)`Vsgp1q@;$Q"><field name="TEXT">Il gruppo viene aperto dai pust, con lunghe tenaglie di legno e rumorosi campanacci, seguito dalle figure del gallo e della gallina, dalla donna che porta il figlio adulto nella gerla, dai due anziani, dalle maschere belle.</field></block></value><value name="ADD2"><block type="text" id="NB%!srO302uK|5zNIY6Y"><field name="TEXT">I blumarji sono giovani vestiti di bianco, con un alto copricapo a forma di albero, campanacci sulla schiena e con in mano un bastone – pištok. In numero dispari compiono un percorso attorno al paese tante volte quante sono i componenti del gruppo.</field></block></value><value name="ADD3"><block type="text" id="GwA8^(F[R^Th75F_5L^N"><field name="TEXT">Il gruppo è composto dai brutti, te gardi, e dai belli, te liepi. I brutti hanno il viso sporco di fuliggine, portano un cappello appuntito, campanacci ed un bastone. I belli sono in sei, tre vestiti da donna e tre da uomo e portano cappelli ricoperti di carta variopinta. </field></block></value><value name="ADD4"><block type="text" id="~|r{DNnJul7_}Rq=9#n!"><field name="TEXT">La caratteristica delle maschere di Clodig è data dal fatto che alcune sono realizzate in vimini. La sfilata ha inizio con maschere che annunciano il carnevale, seguono una coppia di vecchi che raccolgono i doni, le maschere zoomorfe, la morte con la falce e Terezija che porta Vanac nella gerla.</field></block></value><value name="ADD5"><block type="text" id="7/l=|DQtADWNoV=%,=Qs"><field name="TEXT">Nelle sfilate di Carnevale degli Azzidini o Resiani (sin dagli anni 20) era presente il soggetto della MUCCA. La mucca – nella cultura contadina – simboleggia la fertilità e la maternità: infatti è l’animale che soddisfa il bisogno primario del bambino.</field></block></value><value name="ADD6"><block type="text" id="p80eO5G.vqh;!gi~4{sb"><field name="TEXT">Il veliki pust apre il corteo seguito dallo škapjač con le lunghe tenaglie e dai pustje. Seguono le maschere belle con il re e la regina, gli sposi e le coppie di ben vestiti con cappelli adornati di fiori di carta colorata, e le maschere brutte che tengono in mano calze riempite di cenere.</field></block></value></block></value></block><block type="component_event" id="/OZ`EvD[9/3n0/qZlV3b" x="185" y="-186"><mutation component_type="Button" is_generic="false" instance_name="BGallery" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BGallery</field><statement name="DO"><block type="component_set_get" id="nAjmJto16yz`cjX#Bp~`"><mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="ActivityStarter2"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter2</field><field name="PROP">DataUri</field><value name="VALUE"><block type="text_join" id="S/*(O1%jZ.i4./9AA_}|"><mutation items="2"></mutation><value name="ADD0"><block type="text" id="yNrZsHL#U,XPXi.iUOE?"><field name="TEXT">https://example.org/pustbenecija/#</field></block></value><value name="ADD1"><block type="lists_select_item" id="GG8#hdAL5(;yG-o^|/{F"><value name="LIST"><block type="lexical_variable_get" id="1,ievE+f)-ahq`t7eq!0"><field name="VAR">global Locations</field></block></value><value name="NUM"><block type="lexical_variable_get" id="/4wz)?f{}T^]be,;seTI"><field name="VAR">global LocationScreenIndex</field></block></value></block></value></block></value><next><block type="component_method" id="ha#!+r+00WQvc|dd/mmM"><mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="ActivityStarter2"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter2</field></block></next></block></statement></block><block type="component_event" id="NW`GY~N~m}k-[DDKpg59" x="148" y="-16"><mutation component_type="Button" is_generic="false" instance_name="BListen" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BListen</field><statement name="DO"><block type="component_method" id="gyhUJ@tKR.Nd/@R5OIsw"><mutation component_type="TextToSpeech" method_name="Speak" is_generic="false" instance_name="TextToSpeech1"></mutation><field name="COMPONENT_SELECTOR">TextToSpeech1</field><value name="ARG0"><block type="component_set_get" id="_F2nqv.#ZQ{J.#z1B97t"><mutation component_type="Label" set_or_get="get" property_name="Text" is_generic="false" instance_name="DescriptionLabel"></mutation><field name="COMPONENT_SELECTOR">DescriptionLabel</field><field name="PROP">Text</field></block></value></block></statement></block><block type="global_declaration" id="rC}-GAHk~k0_`{.KV{ec" x="-815" y="39"><field name="NAME">DescriptionsGb</field><value name="VALUE"><block type="lists_create_with" id="J_p~XS#wFo@M[_j*H;S~"><mutation items="7"></mutation><value name="ADD0"><block type="text" id="c-r=:tR:@OM]RVQg$fzW"><field name="TEXT">In addition to the pust mask that opens the procession, the devil, zluodij, all black with the wooden mask with two large horns and the gallows in his hand, the anjulac, the angel Michael who tries to keep him at bay with a robust chain.</field></block></value><value name="ADD1"><block type="text" id="*i7D|cXl0`$Gl.!B}.me"><field name="TEXT">The group is opened by the pust, with long wooden tongs and noisy cowbells, followed by the figures of the rooster and the hen, by the woman carrying her adult child in the basket, by the two elderly, with beautiful masks.</field></block></value><value name="ADD2"><block type="text" id="6:;mcG6!{cz^Up!9z-!$"><field name="TEXT">Blumarji are young people dressed in white, with a tall tree-shaped headdress, cowbells on their backs and holding a stick - pištok. In odd numbers, they travel around the town as many times as there are members of the group.</field></block></value><value name="ADD3"><block type="text" id="6%kXr}qxNC+Eoyd#Gi}6"><field name="TEXT">The group is made up of the ugly, te gardi, and the beautiful, te liepi. The ugly have soot-soiled faces, they wear a pointed hat, cowbells and a cane. There are six of them, three dressed as women and three as men, wearing hats covered with colorful paper.</field></block></value><value name="ADD4"><block type="text" id="$m,.|Q/q}M77MKmnQ_#Q"><field name="TEXT">The characteristic of Clodig masks is that some are made of wicker. The parade begins with masks announcing the carnival, followed by a couple of old men who collect the gifts, zoomorphic masks, death with a scythe and Terezija carrying Vanac in the pannier.</field></block></value><value name="ADD5"><block type="text" id="uXb{ah|]O!L4(,}jf6eY"><field name="TEXT">In the Carnival parades of the Azzidini or Resiani (since the 1920s) the subject of the COW was present. The cow - in peasant culture - symbolizes fertility and motherhood: in fact, it is the animal that satisfies the child's primary need.</field></block></value><value name="ADD6"><block type="text" id=",5MC_MI-Ugh1M/_INvF["><field name="TEXT">Veliki pust opens the procession followed by škapjač with long tongs and pustje. Followed by the beautiful masks with the king and queen, the newlyweds and well-dressed couples with hats adorned with colored paper flowers, and the ugly masks holding stockings filled with ash.</field></block></value></block></value></block><block type="component_event" id="@!Ojx]hIte(vJr0L9YVr" disabled="true" x="146" y="92"><mutation component_type="Button" is_generic="false" instance_name="BGallery" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BGallery</field><statement name="DO"><block type="controls_openAnotherScreen" id="]ANdX{|?_|]=Gkf(g}W4"><value name="SCREEN"><block type="helpers_screen_names" id="E!VDPG_v9CGg+|9jDzYh"><field name="SCREEN">GalleryScreen</field></block></value></block></statement></block><block type="global_declaration" id="Vq*!;[StF5Vqn6]gC)]:" x="145" y="198"><field name="NAME">CurrentLocation</field><value name="VALUE"><block type="lists_create_with" id="tcIb$^}5Ph(|imAS2G!g"><mutation items="0"></mutation></block></value></block><block type="global_declaration" id="`S7wY!rGLIa)tl2O+Wm!" x="146" y="242"><field name="NAME">DestinationAddress</field><value name="VALUE"><block type="text" id="OTYJs13Afo_QdM-Wuk;?"><field name="TEXT">46.05333522774499, 14.472003351834035</field></block></value></block><block type="global_declaration" id="?-x:8.+-t9X8g_~t^JLs" x="-824" y="342"><field name="NAME">DescriptionsDe</field><value name="VALUE"><block type="lists_create_with" id="=b-^LKNdK2!E9eS-8]c]"><mutation items="7"></mutation><value name="ADD0"><block type="text" id="ch}FtA0hfiv5#;ByXgCO"><field name="TEXT">Zusätzlich zu der Maske der Pust, die die Prozession öffnet, der Teufel, Zluodij, ganz schwarz mit der Holzmaske mit zwei großen Hörnern und dem Galgen in der Hand, der Anjulac, der Engel Michael, der versucht, ihn mit einem in Schach zu halten robuste Kette.</field></block></value><value name="ADD1"><block type="text" id="S*n%D[=#@4,buXrbYpza"><field name="TEXT">Die Gruppe wird von der Pust mit langen Holzzangen und lauten Kuhglocken eröffnet, gefolgt von den Figuren des Hahns und der Henne, von der Frau, die ihr erwachsenes Kind im Korb trägt, von den beiden älteren Menschen mit schönen Masken.</field></block></value><value name="ADD2"><block type="text" id="FMdI?629Edhjpgv@+t25"><field name="TEXT">Blumarji sind junge Menschen in Weiß, mit einem hohen baumförmigen Kopfschmuck, Kuhglocken auf dem Rücken und einem Stock - pištok. In ungeraden Zahlen machen sie so oft einen Weg durch die Stadt, wie es Mitglieder der Gruppe gibt.</field></block></value><value name="ADD3"><block type="text" id="H^ueGnWDQ|h(?B4}DRVS"><field name="TEXT">Die Gruppe besteht aus dem hässlichen te gardi und dem schönen te liepi. Die Hässlichen haben rußverschmutzte Gesichter, sie tragen einen spitzen Hut, Kuhglocken und einen Stock. Es gibt sechs von ihnen, drei als Frauen und drei als Männer, die mit buntem Papier bedeckte Hüte tragen.</field></block></value><value name="ADD4"><block type="text" id="iQzzfiX4/ez5y;q+;y|S"><field name="TEXT">Das Merkmal von Clodig-Masken ist, dass einige aus Weide bestehen. Die Parade beginnt mit Masken, die den Karneval ankündigen, gefolgt von ein paar alten Männern, die die Geschenke sammeln, zoomorphen Masken, dem Tod mit einer Sense und Theresienstadt, die Vanac in der Tasche tragen.</field></block></value><value name="ADD5"><block type="text" id="S9DxgckCIcDWaZ/:V|E0"><field name="TEXT">Bei den Karnevalsparaden der Azzidini oder Resiani (seit den 1920er Jahren) war das Thema der Kuh anwesend. Die Kuh - in der Bauernkultur - symbolisiert Fruchtbarkeit und Mutterschaft: Tatsächlich ist es das Tier, das das Hauptbedürfnis des Kindes befriedigt.</field></block></value><value name="ADD6"><block type="text" id="h;~@FdEQ14e~5|6p)1LR"><field name="TEXT">Veliki Pust eröffnet die Prozession, gefolgt von škapjač mit langer Zange und Pustje. Gefolgt von den schönen Masken mit dem König und der Königin, den Jungvermählten und gut gekleideten Paaren mit Hüten, die mit farbigen Papierblumen geschmückt sind, und den hässlichen Masken, die mit Asche gefüllte Strümpfe halten.</field></block></value></block></value></block><block type="component_event" id="nh_%~zV/UYyCy@$0sF60" x="148" y="294"><mutation component_type="Button" is_generic="false" instance_name="BNavigate" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BNavigate</field><statement name="DO"><block type="lexical_variable_set" id="w4Reu$x*[6,[-*ckD#61"><field name="VAR">global LocationScreenIndex</field><value name="VALUE"><block type="lists_position_in" id="]IK71!Xj`;]0bN=6@DMn"><value name="ITEM"><block type="component_method" id="XLeCRhQa$h$AP{[=qNLP"><mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation><field name="COMPONENT_SELECTOR">TinyDB1</field><value name="ARG0"><block type="text" id="jJ0Bph4%Q2ktb8|/}j|Y"><field name="TEXT">Pust</field></block></value><value name="ARG1"><block type="text" id="o$Q]Fsp7=,RC.[g!3`tr"><field name="TEXT">Rodda</field></block></value></block></value><value name="LIST"><block type="lexical_variable_get" id="-!iwF|X%OL@x/pdmorw@"><field name="VAR">global Locations</field></block></value></block></value><next><block type="component_set_get" id="d3K*:EC3o/n$qhcZNG@e"><mutation component_type="ActivityStarter" set_or_get="set" property_name="Action" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field><field name="PROP">Action</field><value name="VALUE"><block type="text" id="NhRLols)m[DBTndI0D,/"><field name="TEXT">android.intent.action.VIEW</field></block></value><next><block type="component_set_get" id="3oYNX:lB]Ox3]h=BHJ)Q"><mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field><field name="PROP">DataUri</field><value name="VALUE"><block type="text_join" id="e4I;L6)qUBL[tiD%Vq##"><mutation items="2"></mutation><value name="ADD0"><block type="text" id="p|;zFhPA*M?JU1S9I,6P"><field name="TEXT">http://maps.google.com/maps/?daddr=</field></block></value><value name="ADD1"><block type="lists_select_item" id="q~77!whY+;6{l-!c=f82"><value name="LIST"><block type="lexical_variable_get" id=".l/^s)kJ@[H+PG:U]}4x"><field name="VAR">global Destinations</field></block></value><value name="NUM"><block type="lexical_variable_get" id=":HPJXk0.amj4sLz{/BP("><field name="VAR">global LocationScreenIndex</field></block></value></block></value></block></value><next><block type="component_method" id="F*Psli0FMoJ@WvoX7O19"><mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="ActivityStarter1"></mutation><field name="COMPONENT_SELECTOR">ActivityStarter1</field></block></next></block></next></block></next></block></statement></block><block type="global_declaration" id="A~4jpRJ@y/FyoQ;Q=heY" x="161" y="657"><field name="NAME">Destinations</field><value name="VALUE"><block type="lists_create_with" id="BLKNpEVc8?$K*d`tr+uT"><mutation items="7"></mutation><value name="ADD0"><block type="text" id="NwPB4!D71cWm^!$O~iz6"><field name="TEXT">46.1733437,13.4939898 </field></block></value><value name="ADD1"><block type="text" id="c2vNR]fOYgHzL-CW4ke$"><field name="TEXT">46.185094,13.483994</field></block></value><value name="ADD2"><block type="text" id="y]1Lmc+*O0HsQqa@wY4g"><field name="TEXT">46.1964319,13.4153972</field></block></value><value name="ADD3"><block type="text" id="i%0qOTIjB0pcdGOg)F.,"><field name="TEXT">46.1823756,13.545708</field></block></value><value name="ADD4"><block type="text" id="xCd@jt@Y*,NPtobMaId,"><field name="TEXT">46.1558944,13.5910846</field></block></value><value name="ADD5"><block type="text" id="wh)Hr.j8pfjz4;*|yu#("><field name="TEXT">46.11637800024084,13.488906390466639</field></block></value><value name="ADD6"><block type="text" id="5s5(tx~D]ey1{6dfE?m!"><field name="TEXT">46.1268557,13.5772337</field></block></value></block></value></block><block type="component_event" id="GEgF%{!4^c]]@z#5_zN#" x="-401" y="811"><mutation component_type="Button" is_generic="false" instance_name="BBack" event_name="Click"></mutation><field name="COMPONENT_SELECTOR">BBack</field><statement name="DO"><block type="controls_closeScreen" id="VP?m+RZae!YMhPC?dZQ_"></block></statement></block><yacodeblocks ya-version="221" language-version="36"></yacodeblocks></xml>